{
  "lumos_format": "1.3",
  "kind": "component",
  "component": {
    "id": "lumos.Coupler3dB",
    "version": 1,
    "title": "3-dB coupler",
    "description": "The ideal lossless 3-dB directional coupler (1/sqrt 2)[[1, i], [i, 1]] on two guided lanes: half of the light of each input goes to each output (Pozar, Microwave Engineering, section 7.5).",
    "license": "MIT",
    "authors": [
      "LUMOS"
    ],
    "template": "transfer_matrix",
    "params": {},
    "body": {
      "amplitudes": [
        [
          0.7071067811865475,
          0.7071067811865475
        ],
        [
          0.7071067811865475,
          0.7071067811865475
        ]
      ],
      "phases": "[[0, 1.5707963267948966], [1.5707963267948966, 0]] rad",
      "wavelength": "1550 nm",
      "dispersion": "achromatic"
    },
    "checks": [
      {
        "kind": "power",
        "wavelength": "1550 nm",
        "power": "1 mW",
        "expect": "2 mW",
        "rtol": 1e-09
      }
    ]
  }
}
