msgstr "PNG"

#: ../../web/running.md
msgid "the figure"
msgstr "la figure"

#: ../../web/running.md
msgid "PltEdit (`.plt`)"
msgstr "PltEdit (`.plt`)"

#: ../../web/running.md
msgid "the figure, editable in PltEdit (`pltedit.load`)"
