msgstr ""

#: lumos.backend._core.known:1 of
msgid "Return the names of the backends LUMOS knows about."
msgstr ""

#: lumos.backend._core.set_default:1 of
msgid ""
"Set the default backend for the whole process (``\"auto\"`` or a backend "
"name)."
msgstr ""

#: lumos.backend._core.to_numpy:1 of
msgid "Return ``array`` as a NumPy array (a copy on the host for device arrays)."
msgstr ""

#: lumos.backend._core.use:1 of
