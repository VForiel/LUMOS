msgstr ""

#: lumos.backend:1 of
msgid "Array backends of LUMOS (REQ-HPC-1)."
msgstr ""

#: lumos.backend:3 of
msgid ""
"LUMOS stores its data in arrays of a **backend** and writes numerical "
"code once, against the `Python Array API standard <https://data-apis.org"
"/array-api/>`_:"
msgstr ""

#: lumos.backend:6 of
msgid "``numpy``: the CPU reference, always available;"
msgstr ""

#: lumos.backend:7 of
msgid ""
"``jax``: JIT compilation, vectorisation, automatic differentiation, "
"CPU/GPU/TPU (differentiable reference);"
msgstr ""

#: lumos.backend:8 of
msgid "``cupy`` and ``torch``: optional GPU backends."
msgstr ""

#: lumos.backend:10 of
msgid ""
"Backends are imported only when first used. The **current** backend is "
"local to the running thread or task and changed with :func:`use`::"
msgstr ""

#: lumos.backend:17 of
msgid ""
"Loading the JAX backend enables JAX's 64-bit mode (``jax_enable_x64``), "
"because LUMOS computes in double precision by default (REQ-HPC-5)."
msgstr ""

#: lumos.backend._core.Backend:1 of
msgid "An array backend."
msgstr ""

#: lumos.backend._core.Backend:3 of
msgid "Backend name (``\"numpy\"``, ``\"jax\"``, ``\"cupy\"`` or ``\"torch\"``)."
msgstr ""

#: lumos.backend._core.Backend:5 of
msgid ""
"Array API namespace of the backend (use it like ``numpy``: ``xp.exp``, "
"``xp.sum``...)."
msgstr ""

#: lumos.backend._core.Backend.asarray:1 of
msgid ""
"Create a backend array from ``obj`` (keeping its dtype unless ``dtype`` "
"is given)."
msgstr ""

#: lumos.backend._core.Backend.is_array:1 of
msgid "Whether ``obj`` is an array of this backend."
msgstr ""

#: lumos.backend._core.Backend.to_numpy:1 of
msgid "Copy an array of this backend to a NumPy array (on the host)."
msgstr ""

#: lumos.backend._core.BackendUnavailableError:1 of
msgid "Raised when a known backend is requested but its library is not installed."
msgstr ""

#: lumos.backend._core.available:1 of
msgid ""
"Return the names of the installed backends, ``\"numpy\"`` first (nothing "
"is imported)."
msgstr ""

#: lumos.backend._core.backend_of:1 of
msgid "Return the name of the backend owning ``array``."
msgstr ""

#: lumos.backend._core.backend_of:3 of
msgid "If ``array`` is not an array of a known, installed backend."
msgstr ""

#: lumos.backend._core.convert:1 of
msgid "Convert ``array`` to an array of backend ``name``, keeping its dtype."
msgstr ""

#: lumos.backend._core.current:1 of
msgid "Return the backend active in the current thread or task."
msgstr ""

#: lumos.backend._core.get:1 of
msgid "Return the backend ``name`` (the current backend if ``name`` is ``None``)."
msgstr ""

#: lumos.backend._core.get:3 of
msgid "If the name is unknown."
msgstr ""

#: lumos.backend._core.get:4 of
msgid "If the backend library is not installed."
msgstr ""

#: lumos.backend._core.get_default:1 of
msgid ""
"Return the default backend setting: ``\"auto\"`` or a backend name (same "
"as ``lumos.config.backend``)."
msgstr ""

#: lumos.backend._core.known:1 of
msgid "Return the names of the backends LUMOS knows about."
msgstr ""

#: lumos.backend._core.set_default:1 of
msgid ""
"Set the default backend for the whole process (``\"auto\"`` or a backend "
"name)."
msgstr ""

#: lumos.backend._core.to_numpy:1 of
msgid "Return ``array`` as a NumPy array (a copy on the host for device arrays)."
msgstr ""

#: lumos.backend._core.use:1 of
msgid ""
"Use backend ``name`` inside a ``with`` block (local to the current thread"
" or task)."
msgstr ""

#: lumos.backend.fft:1 of
msgid "Two-dimensional FFTs on any backend."
msgstr ""

#: lumos.backend.fft:3 of
msgid ""
"Every function works on the backend of its input array: JAX arrays are "
"transformed by JAX, CuPy arrays on the GPU, and NumPy arrays by "
":mod:`scipy.fft`, which keeps single precision and uses "
"``lumos.config.fft_workers`` CPU threads."
msgstr ""

#: lumos.backend.fft:7 of
msgid ""
"The *centred* transforms :func:`fft2c` and :func:`ifft2c` assume that the"
" origin of both the input and the output grids is the pixel of index ``N "
"// 2`` along each axis (convention of LUMOS, §9 of the specs). They are "
"the natural transforms for optics, where fields are centred on the "
"optical axis."
msgstr ""

#: lumos.backend.fft.fft2:1 of
msgid ""
"Return the discrete Fourier transform of ``array`` over ``axes`` (origin "
"at index 0)."
msgstr ""

#: lumos.backend.fft.fft2c:1 of
msgid ""
"Return the centred Fourier transform of ``array`` (origins of both grids "
"at index ``N // 2``)."
msgstr ""

#: lumos.backend.fft.fftfreq:1 of
msgid ""
"Return the sample frequencies of an ``n``-point FFT with sample spacing "
"``d``."
msgstr ""

#: lumos.backend.fft.fftfreq:3 of
msgid ""
"The array is created with ``backend`` (the current backend by default), "
"in FFT order (zero first)."
msgstr ""

#: lumos.backend.fft.fftshift:1 of
msgid ""
"Move the zero-frequency sample from index 0 to index ``N // 2`` along "
"``axes``."
msgstr ""

#: lumos.backend.fft.ifft2:1 of
msgid ""
"Return the inverse discrete Fourier transform of ``array`` over ``axes`` "
"(origin at index 0)."
msgstr ""

#: lumos.backend.fft.ifft2c:1 of
msgid ""
"Return the centred inverse Fourier transform of ``array`` (inverse of "
":func:`fft2c`)."
msgstr ""

#: lumos.backend.fft.ifftshift:1 of
msgid ""
"Inverse of :func:`fftshift`: move the sample at index ``N // 2`` to index"
" 0 along ``axes``."
msgstr ""

#: lumos.backend.hardware:1 of
msgid "Hardware detection and automatic backend selection (REQ-HPC-2, ADR-0004)."
msgstr ""

#: lumos.backend.hardware:3 of
msgid ""
":func:`hardware_report` describes the machine LUMOS runs on: operating "
"system, CPU, memory, GPUs seen by the installed backends and versions of "
"the main libraries. The report is stored in archive metadata (REQ-RES-2) "
"and drives :func:`select_backend`, used when ``lumos.config.backend`` is "
"``\"auto\"``."
msgstr ""

#: lumos.backend.hardware.GPUInfo:1 of
msgid "A GPU (or other accelerator) seen by a backend."
msgstr ""

#: lumos.backend.hardware.HardwareReport:1 of
msgid "Description of the machine and software environment."
msgstr ""

#: lumos.backend.hardware.HardwareReport.to_dict:1 of
msgid "Return the report as plain data (YAML and JSON serialisable)."
msgstr ""

#: lumos.backend.hardware.HardwareReport.summary:1 of
msgid "Return a short human-readable description."
msgstr ""

#: lumos.backend.hardware.select_backend:1 of
msgid ""
"Choose the backend to use on the machine described by ``report`` (policy "
"of ADR-0004)."
msgstr ""

#: lumos.backend.hardware.select_backend:3 of
msgid ""
"A GPU backend is chosen when it sees a GPU, JAX first, then CuPy, then "
"PyTorch; otherwise NumPy, the CPU reference."
msgstr ""

#: lumos.backend.memory:1 of
msgid ""
"Numerical precision, memory estimates and chunked computation (REQ-HPC-4,"
" REQ-HPC-5)."
msgstr ""

#: lumos.backend.memory:3 of
msgid ""
"Large computations (a wavecube of hundreds of wavelengths, thousands of "
"incoherent modes...) may not fit in memory at once. Most of them are "
"independent along one axis, so :func:`map_chunked` cuts the input along "
"that axis into chunks that fit a memory budget, applies the computation "
"to each chunk and concatenates the results, which are identical to those "
"of a single computation."
msgstr ""

#: lumos.backend.memory.available_memory:1 of
msgid ""
"Return the memory in bytes currently available to ``backend`` (the "
"current backend by default)."
msgstr ""

#: lumos.backend.memory.available_memory:3 of
msgid ""
"CPU backends report the available RAM; GPU backends report the free "
"memory of their first device."
msgstr ""

#: lumos.backend.memory.chunk_slices:1 of
msgid ""
"Split ``range(n)`` into consecutive slices of at most ``budget_bytes // "
"item_bytes`` items."
msgstr ""

#: lumos.backend.memory.chunk_slices:3 of
msgid ""
"Every chunk holds at least one item, even when a single item exceeds the "
"budget."
msgstr ""

#: lumos.backend.memory.dtypes:1 of
msgid "Return the ``(real, complex)`` dtypes of ``backend`` for ``precision``."
msgstr ""

#: lumos.backend.memory.dtypes:3 of
msgid ""
"``\"double\"`` (float64 / complex128) or ``\"single\"`` (float32 / "
"complex64); defaults to ``lumos.config.precision``."
msgstr ""

#: lumos.backend.memory.dtypes:5 of
msgid "Backend name; defaults to the current backend."
msgstr ""

#: lumos.backend.memory.estimate_bytes:1 of
msgid "Return the size in bytes of an array of ``shape`` and ``dtype``."
msgstr ""

#: lumos.backend.memory.map_chunked:1 of
msgid ""
"Apply ``function`` to chunks of ``array`` along ``axis`` and concatenate "
"the results."
msgstr ""

#: lumos.backend.memory.map_chunked:3 of
msgid ""
"``function`` must treat the elements along ``axis`` independently and "
"keep their number (for example a 2-D FFT applied to every wavelength of a"
" cube). The result equals ``function(array)``."
msgstr ""

#: lumos.backend.memory.map_chunked:6 of
msgid "Computation to apply; it receives and returns arrays of the same backend."
msgstr ""

#: lumos.backend.memory.map_chunked:7 of
msgid "Input array."
msgstr ""

#: lumos.backend.memory.map_chunked:8 of
msgid "Axis along which the input is cut."
msgstr ""

#: lumos.backend.memory.map_chunked:9 of
msgid ""
"Maximum size of the input of one chunk; defaults to a quarter of the "
"memory available to the backend."
msgstr ""

#: ../../api/index.md:39
