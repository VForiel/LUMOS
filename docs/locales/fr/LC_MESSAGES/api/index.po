#: ../../api/index.md:139
msgid "Propagation"
msgstr ""

#: lumos.propagation:1 of
msgid ""
"Numerical propagation of optical fields between arbitrary planes and "
"grids (``REQ-PROP-*``)."
msgstr ""

#: lumos.propagation:3 of
msgid ""
":func:`propagate`: free-space propagation over a distance, or to the far "
"field;"
msgstr ""

#: lumos.propagation:4 of
msgid ":func:`focus`: focal plane of a thin lens;"
msgstr ""

#: lumos.propagation:5 of
msgid ""
":func:`methods`: the available methods; ``method=\"auto\"`` lets the "
"planner choose and log one;"
msgstr ""

#: lumos.propagation:6 of
msgid ":func:`plan`: the planner's choice and its reason, without propagating."
msgstr ""

#: lumos.propagation._common.cache_info:1 of
msgid ""
"Statistics of the propagation kernel cache (hits, misses, maxsize, "
"currsize)."
msgstr ""

#: lumos.propagation._common.clear_cache:1 of
msgid "Empty the propagation kernel cache."
msgstr ""

#: lumos.propagation.api.focus:1 of
msgid ""
"Field in the focal plane of a thin lens of focal length ``f`` placed in "
"the plane of ``signal``."
msgstr ""

#: lumos.propagation.api.focus:3 of
msgid ""
"The lens multiplies the field by :math:`\\exp(-ik r^2 / 2f)` and the "
"field then propagates over :math:`f`. With ``method=\"fraunhofer\"`` (the"
" default choice of the planner) this is evaluated exactly as"
msgstr ""

#: lumos.propagation.api.focus:6 of
msgid ""
"U_f(x, y) = \\frac{e^{ikf}}{i\\lambda f} e^{ik(x^2 + y^2)/2f}\\,\n"
"\\tilde U\\!\\left(\\frac{x}{\\lambda f}, \\frac{y}{\\lambda f}\\right),\n"
"\n"
msgstr ""

#: lumos.propagation.api.focus:9 of
msgid ""
"the Fresnel integral whose input quadratic phase the lens cancels; other "
"methods apply the lens phase and propagate. The output sampling is "
"arbitrary (matrix Fourier transform)."
msgstr ""

#: lumos.propagation.api.methods:1 of
msgid ""
"Return the registered propagation methods by name (``\"auto\"`` is the "
"planner, not listed)."
msgstr ""

#: lumos.propagation.api.plan:1 of
msgid ""
"Return the :class:`~lumos.propagation.planner.Plan` that "
":func:`propagate` would follow."
msgstr ""

#: lumos.propagation.api.propagate:1 of
msgid ""
"Propagate a field from the plane ``z = 0`` to the plane ``z = distance`` "
"in free space (vacuum)."
msgstr ""

#: lumos.propagation.api.propagate:3 of
msgid ""
":class:`~lumos.fields.Wavefront`, :class:`~lumos.fields.Wavecube` or "
":class:`~lumos.fields.IncoherentBundle` on a spatial grid."
msgstr ""

#: lumos.propagation.api.propagate:5 of
msgid ""
"Propagation distance (negative to back-propagate), or ``None`` for the "
"far field: the output is then the angular spectrum on an angular grid of "
"direction cosines, normalised so that :math:`\\sum |U|^2 \\Delta\\Omega` "
"is the power."
msgstr ""

#: lumos.propagation.api.propagate:8 of
msgid ""
"Sampling of the output plane; defaults to the input grid (required for "
"the far field)."
msgstr ""

#: lumos.propagation.api.propagate:9 of
msgid ""
"``\"auto\"`` (the planner chooses and logs the method) or one of "
":func:`methods`."
msgstr ""

#: lumos.propagation.api.propagate:10 of
msgid ""
"Optional memory budget in bytes: the modes of an incoherent bundle are "
"then propagated in chunks."
msgstr ""

#: lumos.propagation.api.propagate:12 of
msgid "Signal of the same type on ``output_grid``."
msgstr ""

#: lumos.propagation.api.register_method:1 of
msgid "Register a propagation method under ``method.name``."
msgstr ""

#: lumos.propagation.planner:1 of
msgid ""
"Automatic choice of the propagation method (REQ-PROP-4, step P4.6, "
"ADR-0005)."
msgstr ""

#: lumos.propagation.planner:3 of
msgid "The planner inspects the field itself, not only the grids: it measures"
msgstr ""

#: lumos.propagation.planner:5 of
#, python-brace-format
msgid ""
"the **spatial support**, the smallest box holding :math:`1 - 10^{-6}` of "
"the power;"
msgstr ""

#: lumos.propagation.planner:6 of
#, python-brace-format
msgid ""
"the **spectral support**, the highest spatial frequency below which "
":math:`1 - 10^{-6}` of the spectral power lies along each axis;"
msgstr ""

#: lumos.propagation.planner:9 of
msgid ""
"and applies the rules of ADR-0005, in order, for every wavelength of the "
"signal:"
msgstr ""

#: lumos.propagation.planner:11 of
msgid "far field (``distance=None``): ``\"fraunhofer\"``;"
msgstr ""

#: lumos.propagation.planner:12 of
msgid ""
"back-propagation (:math:`z < 0`): ``\"asm\"``, whose transfer function is"
" exactly invertible;"
msgstr ""

#: lumos.propagation.planner:13 of
msgid ""
"``\"asm\"`` (exact) if the spectral support lies inside the Matsushima "
"band limit and the output plane lies inside the zero-padded window;"
msgstr ""

#: lumos.propagation.planner:15 of
msgid ""
"Fresnel methods if the neglected phase :math:`k\\rho^4/8z^3 \\le 0.01` "
"rad for the largest lateral distance :math:`\\rho` between the support "
"and the output plane:"
msgstr ""

#: lumos.propagation.planner:18 of
msgid ""
"``\"fresnel_mft\"`` if the chirped field is sampled (its local "
"frequencies stay below Nyquist) and the output frequencies do not reach "
"the periodic replicas;"
msgstr ""

#: lumos.propagation.planner:20 of
msgid ""
"otherwise ``\"fresnel_ir\"`` (:math:`\\Delta x \\le \\lambda z / L`) or "
"``\"fresnel_tf\"`` on the input grid;"
msgstr ""

#: lumos.propagation.planner:22 of
#, python-brace-format
msgid ""
"``\"fraunhofer\"`` at finite distance if, in addition, the input "
"quadratic phase :math:`k\\rho_\\mathrm{in}^2 / 2z \\le 0.05` rad;"
msgstr ""

#: lumos.propagation.planner:24 of
msgid ""
"``\"rs\"``, the direct sum, valid everywhere but expensive (a warning is "
"logged above :data:`RS_WARNING_COST` operations)."
msgstr ""

#: lumos.propagation.planner:27 of
msgid ""
"The choice and its reason are logged at the INFO level on the "
"``lumos.propagation`` logger, and :func:`plan` returns them without "
"propagating."
msgstr ""

#: lumos.propagation.planner.Plan:1 of
msgid "Outcome of the planner."
msgstr ""

#: lumos.propagation.planner.Plan:3 of
msgid "Name of the chosen method."
msgstr ""

#: lumos.propagation.planner.Plan:5 of
msgid "Why it was chosen."
msgstr ""

#: lumos.propagation.planner.Plan:7 of
msgid "Estimated number of complex operations per wavelength and component."
msgstr ""

#: lumos.propagation.planner.Plan:9 of
msgid "Grid on which the field will be computed."
msgstr ""

#: lumos.propagation.rs:1 of
msgid ""
"Direct Rayleigh-Sommerfeld propagation, the reference method (REQ-PROP-1,"
" step P4.2)."
msgstr ""

#: lumos.propagation.rs:3 of
msgid ""
"The first Rayleigh-Sommerfeld solution gives the field at :math:`(x, y, "
"z)` from the field at :math:`z = 0` (Goodman, *Introduction to Fourier "
"Optics*, 3rd ed., eq. 3-42):"
msgstr ""

#: lumos.propagation.rs:6 of
#, python-brace-format
msgid ""
"U(x, y, z) = \\iint U(x', y', 0)\\, h(r)\\, dx'\\, dy', \\qquad\n"
"h(r) = \\frac{z}{2\\pi r^2}\\left(\\frac{1}{r} - ik\\right) e^{ikr},\n"
"\n"
msgstr ""

#: lumos.propagation.rs:9 of
#, python-brace-format
msgid ""
"with :math:`r = \\sqrt{(x - x')^2 + (y - y')^2 + z^2}`. The integral is "
"evaluated as a direct sum over the input pixels for every output point, "
"which is exact for the sampled field (no paraxial or far-field "
"approximation) and works between any grids. Its cost is "
":math:`N_\\mathrm{in} N_\\mathrm{out}`, so it is used for validation and "
"for small grids; the output points are processed in chunks to bound the "
"memory."
msgstr ""

#: lumos.propagation.rs:14 of
msgid ""
"The sum is accurate when the phase of :math:`h` changes by much less than"
" :math:`2\\pi` across one input pixel, i.e. :math:`k\\,\\rho\\,\\Delta x "
"/ r \\ll 2\\pi` where :math:`\\rho` is the lateral distance."
msgstr ""

#: lumos.propagation.fraunhofer:1 of
msgid ""
"Fraunhofer propagation with matrix Fourier transforms (REQ-PROP-2, step "
"P4.3)."
msgstr ""

#: lumos.propagation.fraunhofer:4 of
#, fuzzy
msgid "Far field"
msgstr "Fichiers"

#: lumos.propagation.fraunhofer:5 of
msgid ""
"At infinite distance the field in the direction of direction cosines "
":math:`(\\alpha, \\beta)` is the Fourier transform of the pupil field at "
"the spatial frequencies :math:`(\\alpha/\\lambda, \\beta/\\lambda)` "
"(Goodman, *Introduction to Fourier Optics*, §4.2):"
msgstr ""

#: lumos.propagation.fraunhofer:9 of
#, python-brace-format
msgid ""
"U_\\infty(\\alpha, \\beta) = \\frac{1}{i\\lambda} \\iint U(x, y)\\,\n"
"e^{-2\\pi i (\\alpha x + \\beta y)/\\lambda}\\, dx\\, dy ,\n"
"\n"
msgstr ""

#: lumos.propagation.fraunhofer:12 of
msgid ""
"normalised so that :math:`\\iint |U_\\infty|^2 d\\alpha\\, d\\beta` is "
"the power (Parseval)."
msgstr ""

#: lumos.propagation.fraunhofer:15 of
msgid "Finite distance and focal plane"
msgstr ""

#: lumos.propagation.fraunhofer:16 of
msgid ""
"At a distance :math:`z` in the Fraunhofer regime (Fresnel number "
":math:`a^2/\\lambda z \\ll 1`), or in the focal plane of a thin lens of "
"focal length :math:`z` placed in the input plane (where the lens cancels "
"the input quadratic phase exactly),"
msgstr ""

#: lumos.propagation.fraunhofer:20 of
msgid ""
"U(x, y) = \\frac{e^{ikz}}{i\\lambda z} e^{ik(x^2 + y^2)/2z}\n"
"\\iint U(x', y')\\, e^{-2\\pi i (x x' + y y')/\\lambda z}\\, dx'\\, dy' ."
"\n"
"\n"
msgstr ""

#: lumos.propagation.fraunhofer:23 of
#, python-brace-format
msgid ""
"The transforms are evaluated as matrix Fourier transforms (Soummer et al."
" 2007, Opt. Express 15, 15935): two matrix products with :math:`e^{-2\\pi"
" i u x}` matrices, so the output sampling and centre are arbitrary and "
"the cost is :math:`O(N^2 M + N M^2)` for :math:`N^2` input and "
":math:`M^2` output pixels."
msgstr ""

#: lumos.propagation.fresnel:1 of
msgid "Fresnel (paraxial) propagation (REQ-PROP-2, step P4.4)."
msgstr ""

#: lumos.propagation.fresnel:3 of
msgid ""
"In the Fresnel approximation the field at distance :math:`z` is the "
"convolution of the input field with the paraxial impulse response "
"(Goodman, *Introduction to Fourier Optics*, §4.2):"
msgstr ""

#: lumos.propagation.fresnel:6 of
msgid ""
"U(x, y, z) = \\iint U(x', y', 0)\\, h(x - x', y - y')\\, dx'\\, dy', "
"\\qquad\n"
"h(x, y) = \\frac{e^{ikz}}{i\\lambda z} e^{ik(x^2 + y^2)/2z},\n"
"\n"
msgstr ""

#: lumos.propagation.fresnel:9 of
#, python-brace-format
msgid ""
"whose transfer function is :math:`H(f_x, f_y) = e^{ikz} e^{-i\\pi\\lambda"
" z (f_x^2 + f_y^2)}`. The approximation holds when the neglected term of "
"the phase is small, :math:`k \\rho^4 / 8 z^3 \\ll 1` for lateral "
"distances :math:`\\rho`."
msgstr ""

#: lumos.propagation.fresnel:13 of
msgid ""
"Three discretisations are provided (Voelz, *Computational Fourier "
"Optics*, 2011, §5):"
msgstr ""

#: lumos.propagation.fresnel:15 of
msgid ""
"``\"fresnel_tf\"`` multiplies the spectrum by :math:`H` (FFT, output on "
"the input grid). It is accurate when the chirp of :math:`H` is sampled "
"over the spectrum of the field, typically for short distances, "
":math:`\\Delta x \\gtrsim \\lambda z / L`;"
msgstr ""

#: lumos.propagation.fresnel:18 of
msgid ""
"``\"fresnel_ir\"`` convolves with the sampled :math:`h` (FFT, output on "
"the input grid), accurate for longer distances, :math:`\\Delta x "
"\\lesssim \\lambda z / L`;"
msgstr ""

#: lumos.propagation.fresnel:20 of
msgid ""
"``\"fresnel_mft\"`` expands the quadratic phase and evaluates one Fourier"
" integral with a matrix Fourier transform, which gives the field on "
"**any** output grid:"
msgstr ""

#: lumos.propagation.fresnel:23 of
msgid ""
"U(x, y, z) = \\frac{e^{ikz}}{i\\lambda z} e^{ik(x^2 + y^2)/2z} \\iint "
"U(x', y')\\,\n"
"e^{ik(x'^2 + y'^2)/2z} e^{-2\\pi i (x x' + y y')/\\lambda z} dx'\\, dy',\n"
"\n"
msgstr ""

#: lumos.propagation.fresnel:26 of
msgid ""
"accurate when the input chirp is sampled over the support of the field, "
":math:`k \\rho\\, \\Delta x / z < \\pi`."
msgstr ""

#: lumos.propagation.fresnel:28 of
msgid ""
"The FFT methods zero-pad the field by a factor 2 to avoid circular wrap-"
"around. Negative distances back-propagate."
msgstr ""

#: lumos.propagation.asm:1 of
msgid "Band-limited angular spectrum propagation (REQ-PROP-2, step P4.5)."
msgstr ""

#: lumos.propagation.asm:3 of
#, python-brace-format
msgid ""
"The angular spectrum method is exact for free-space propagation of the "
"sampled field (no paraxial approximation; Goodman, *Introduction to "
"Fourier Optics*, §3.10): the spectrum :math:`A(f_x, f_y) = \\iint U "
"e^{-2\\pi i (f_x x + f_y y)} dx\\, dy` is multiplied by the transfer "
"function"
msgstr ""

#: lumos.propagation.asm:7 of
msgid ""
"H(f_x, f_y) = \\exp\\left(2\\pi i z \\sqrt{\\lambda^{-2} - f_x^2 - "
"f_y^2}\\right)\n"
"\n"
msgstr ""

#: lumos.propagation.asm:9 of
msgid ""
"(evanescent components decay for :math:`z > 0` and are removed when back-"
"propagating), and the field is recovered by the inverse transform."
msgstr ""

#: lumos.propagation.asm:13 of
msgid "Band limit"
msgstr ""

#: lumos.propagation.asm:14 of
msgid ""
"Sampling :math:`H` on the frequency grid of a window of width :math:`2S` "
"(the field zero-padded by 2) aliases its chirp at long distances. "
"Following Matsushima & Shimobaba (2009, Opt. Express 17, 19662), "
"frequencies are kept only up to"
msgstr ""

#: lumos.propagation.asm:18 of
msgid ""
"|f_x| \\le \\frac{1}{\\lambda \\sqrt{(2 \\Delta f_x z)^2 + 1}}, \\qquad "
"\\Delta f_x = \\frac{1}{2 S_x},\n"
"\n"
msgstr ""

#: lumos.propagation.asm:20 of
msgid ""
"and likewise along y. The method is accurate when the spectrum of the "
"field lies inside this band, which the planner checks."
msgstr ""

#: lumos.propagation.asm:24 of
msgid "Output grids"
msgstr ""

#: lumos.propagation.asm:25 of
msgid ""
"On the input grid the inverse transform is an FFT. On any other grid "
"(scaled, shifted or rectangular output) the inverse transform is "
"evaluated as a matrix Fourier transform at the output coordinates, the "
"\"scaled/shifted\" angular spectrum: exact for the band-limited field, "
"valid as long as the output plane stays inside the padded window."
msgstr ""

#: ../../api/index.md:154
msgid "Physical models"
msgstr ""

#: lumos.physics.blackbody:1 of
msgid "Thermal emission (Planck's law)."
msgstr ""

#: lumos.physics.blackbody:3 of
msgid "The spectral radiance of a blackbody per unit wavelength is"
msgstr ""

#: lumos.physics.blackbody:5 of
msgid ""
"B_\\lambda(T) = \\frac{2 h c^2}{\\lambda^5} \\frac{1}{e^{hc/\\lambda k T}"
" - 1}\n"
"\n"
msgstr ""

#: lumos.physics.blackbody:7 of
msgid ""
"in W m⁻² sr⁻¹ m⁻¹, and its photon radiance is :math:`B_\\lambda \\lambda "
"/ hc` (Rybicki & Lightman, *Radiative Processes in Astrophysics*, §1.5). "
"Constants are the exact 2019 SI values."
msgstr ""

#: lumos.physics.blackbody.planck_lambda:1 of
msgid "Spectral radiance of a blackbody per unit wavelength."
msgstr ""

#: lumos.physics.blackbody.planck_lambda_si:1 of
msgid ""
"Planck spectral radiance in W m⁻² sr⁻¹ m⁻¹ for SI wavelengths (m) and "
"temperatures (K)."
msgstr ""

#: lumos.physics.blackbody.planck_photon_lambda:1 of
msgid ""
"Photon spectral radiance of a blackbody per unit wavelength (photon s⁻¹ "
"m⁻² sr⁻¹ m⁻¹)."
msgstr ""

#: lumos.physics.photometry:1 of
msgid ""
"Photometry: magnitude systems, photometric bands and phase functions "
"(REQ-SCN-5)."
msgstr ""

#: lumos.physics.photometry:4 of
msgid "Magnitudes"
msgstr ""

#: lumos.physics.photometry:5 of
#, python-brace-format
msgid ""
"**AB** magnitudes are defined by :math:`m_\\mathrm{AB} = "
"-2.5\\log_{10}(F_\\nu / 3631\\ \\mathrm{Jy})` (Oke & Gunn 1983, ApJ 266, "
"713)."
msgstr ""

#: lumos.physics.photometry:7 of
#, python-brace-format
msgid ""
"**Vega** magnitudes of the Johnson-Cousins-Glass system use the zero "
"points of Bessell, Castelli & Plez (1998, A&A 333, 231, table A2): "
":math:`F_\\nu = F_{\\nu,0} 10^{-0.4 m}` at the effective wavelength of "
"the band."
msgstr ""

#: lumos.physics.photometry:11 of
msgid ""
"Bands are described by their effective wavelength and an approximate full"
" width; filter transmission curves come with the catalogue services "
"(phase 9)."
msgstr ""

#: lumos.physics.photometry:15 of
msgid "Phase function"
msgstr ""

#: lumos.physics.photometry:16 of
msgid ""
"A Lambertian sphere seen at phase angle :math:`\\alpha` reflects the "
"fraction :math:`\\Phi(\\alpha) = [\\sin\\alpha + (\\pi - "
"\\alpha)\\cos\\alpha] / \\pi` of its full-phase flux (Sobolev 1975)."
msgstr ""

#: lumos.physics.photometry.AB_ZERO_POINT:1 of
msgid "Zero point of AB magnitudes."
msgstr ""

#: lumos.physics.photometry.BANDS:1 of
msgid ""
"effective wavelengths and zero points of Bessell, Castelli & Plez (1998, "
"table A2); widths are approximate full widths of the filters."
msgstr ""

#: lumos.physics.photometry.BANDS:4 of
msgid "Johnson-Cousins-Glass bands"
msgstr ""

#: lumos.physics.photometry.Band:1 of
msgid ""
"A photometric band: effective wavelength, approximate width and Vega zero"
" point (``F_ν`` at m = 0)."
msgstr ""

#: lumos.physics.photometry.ab_magnitude:1 of
msgid "AB magnitude of a spectral flux density per unit frequency."
msgstr ""

#: lumos.physics.photometry.flux_from_magnitude:1 of
msgid ""
"Spectral flux density ``F_ν`` of a Vega magnitude in ``band`` (at its "
"effective wavelength)."
msgstr ""

#: lumos.physics.photometry.lambert_phase:1 of
msgid ""
"Phase function of a Lambertian sphere at ``phase_angle`` (1 at full "
"phase)."
msgstr ""

#: lumos.physics.photometry.magnitude_from_flux:1 of
msgid "Vega magnitude of a spectral flux density ``F_ν`` in ``band``."
msgstr ""

#: lumos.physics.photometry.photon_flux_from_fnu_si:1 of
msgid ""
"Photon flux density per unit wavelength (photon s⁻¹ m⁻² m⁻¹) from "
":math:`F_\\nu` (W m⁻² Hz⁻¹)."
msgstr ""

#: lumos.physics.photometry.photon_flux_from_fnu_si:3 of
msgid ""
":math:`F_\\lambda = F_\\nu c/\\lambda^2` and one photon carries "
":math:`hc/\\lambda`, so the photon flux is :math:`F_\\nu / (h \\lambda)`."
msgstr ""

#: lumos.physics.orbits:1 of
msgid "Keplerian orbits (REQ-SCN-2, REQ-SCN-7)."
msgstr ""

#: lumos.physics.orbits:3 of
#, python-brace-format
msgid ""
"A bound orbit of semi-major axis :math:`a` and eccentricity :math:`e` "
"around a mass :math:`M` has the period :math:`P = 2\\pi\\sqrt{a^3 / GM}` "
"(Kepler's third law). The position at time :math:`t` follows from the "
"mean anomaly :math:`M = 2\\pi (t - t_p)/P`, the eccentric anomaly solving"
" Kepler's equation :math:`E - e \\sin E = M`, the true anomaly "
":math:`\\nu` and the radius :math:`r = a(1 - e\\cos E)` (Murray & "
"Dermott, *Solar System Dynamics*, §2.4)."
msgstr ""

#: lumos.physics.orbits:9 of
msgid ""
"Orientation: the orbit lies in a plane inclined by :math:`i` about the "
"line of nodes (the x axis rotated by the longitude of the ascending node "
":math:`\\Omega`), with argument of periapsis :math:`\\omega`. The "
"observer looks down the -z axis (z points towards the observer); :math:`i"
" = 0` is face-on."
msgstr ""

#: lumos.physics.orbits.kepler_position:1 of
msgid ""
"Projected position ``(x, y)`` on the sky plane (see "
":func:`kepler_position_3d`)."
msgstr ""

#: lumos.physics.orbits.kepler_position_3d:1 of
msgid ""
"Return the position ``(x, y, z)`` at time ``t`` (unit of ``a``, radians, "
"z towards the observer)."
msgstr ""

#: lumos.physics.orbits.orbital_period:1 of
msgid "Period of an orbit of semi-major axis ``a`` around ``mass``."
msgstr ""

#: lumos.physics.orbits.orbital_period_si:1 of
msgid ""
"Period in seconds of an orbit of semi-major axis ``a`` (m) around "
"``mass`` (kg)."
msgstr ""

#: lumos.physics.orbits.solve_kepler:1 of
msgid ""
"Solve Kepler's equation ``E - e sin E = M`` for the eccentric anomaly "
"``E`` (Newton's method)."
msgstr ""

#: lumos.physics.apertures:1 of
msgid "Aperture masks on sampling grids (§5.9, step P6.2)."
msgstr ""

#: lumos.physics.apertures:3 of
msgid ""
"Masks are amplitude transmissions between 0 and 1 sampled on a "
":class:`~lumos.fields.Grid` (in its SI unit: metres for pupils). Edges "
"are **anti-aliased**: each pixel is split into ``supersample × "
"supersample`` sub-pixels and its value is the fraction of sub-pixels "
"inside the shape, which makes the sampled area converge to the exact area"
" and avoids the aliasing of binary edges in the far field."
msgstr ""

#: lumos.physics.apertures:8 of
msgid ""
"Shapes: disks, annuli, regular polygons, radial spider vanes and "
"primaries made of hexagonal segments on a hexagonal lattice (ring by ring"
" around the centre)."
msgstr ""

#: lumos.physics.apertures.annulus:1 of
msgid ""
"Annulus between the diameters ``inner`` and ``outer`` (SI), centred on "
"the origin."
msgstr ""

#: lumos.physics.apertures.disk:1 of
msgid "Disk of ``diameter`` (SI) centred on ``center``."
msgstr ""

#: lumos.physics.apertures.hex_centers:1 of
msgid "Centres of hexagonal segments ring by ring on a lattice of ``pitch`` (SI)."
msgstr ""

#: lumos.physics.apertures.hex_centers:3 of
msgid ""
"Segments have two vertices along x; neighbours are at angles 30° + k·60°."
" With ``outer_radius`` (or ``inner_radius``), only segments lying "
"entirely inside (outside) the circle are kept."
msgstr ""

#: lumos.physics.apertures.hex_segments:1 of
msgid ""
"Primary made of hexagonal segments of ``flat_to_flat`` width separated by"
" ``gap`` (SI)."
msgstr ""

#: lumos.physics.apertures.hex_segments:3 of
msgid "Returns the mask and the number of segments."
msgstr ""

#: lumos.physics.apertures.regular_polygon:1 of
msgid ""
"Regular ``n``-gon with a vertex at angle ``rotation`` from +x, inscribed "
"in ``circumradius`` (SI)."
msgstr ""

#: lumos.physics.apertures.spiders:1 of
msgid ""
"Coverage (1 = blocked) of ``n`` radial vanes of ``width`` (SI) starting "
"at the centre."
msgstr ""

#: lumos.physics.apertures.spiders:3 of
msgid "The first vane points at angle ``rotation`` from +x."
msgstr ""

#: lumos.physics.zernike:1 of
msgid ""
"Zernike polynomials in Noll's ordering and normalisation (Noll 1976, JOSA"
" 66, 207)."
msgstr ""

#: lumos.physics.zernike:3 of
msgid ""
"Mode :math:`j \\ge 1` has the radial order :math:`n` and the azimuthal "
"frequency :math:`m` given by :func:`noll_indices` (:math:`m > 0` for "
"cosines, :math:`m < 0` for sines, even :math:`j` for cosines):"
msgstr ""

#: lumos.physics.zernike:6 of
msgid ""
"Z_j = \\sqrt{n + 1}\\, R_n^0(\\rho) \\quad (m = 0), \\qquad\n"
"Z_j = \\sqrt{2(n + 1)}\\, R_n^{|m|}(\\rho) \\times \\begin{cases} \\cos "
"m\\theta \\\\ \\sin |m|\\theta \\end{cases},\n"
"\n"
"R_n^{m}(\\rho) = \\sum_{s=0}^{(n-m)/2}\n"
"\\frac{(-1)^s (n - s)!}{s!\\,(\\frac{n+m}{2} - s)!\\,(\\frac{n-m}{2} - "
"s)!}\\, \\rho^{n - 2s},"
msgstr ""

#: lumos.physics.zernike:13 of
#, python-brace-format
msgid ""
"so that :math:`\\frac{1}{\\pi}\\int_{\\rho \\le 1} Z_i Z_j = "
"\\delta_{ij}`: a coefficient is the RMS of its mode over the pupil."
msgstr ""

#: lumos.physics.zernike.noll_indices:1 of
msgid ""
"Return the radial order ``n`` and the signed azimuthal frequency ``m`` of"
" Noll mode ``j``."
msgstr ""

#: lumos.physics.zernike.zernike:1 of
msgid ""
"Evaluate Noll mode ``j`` at polar coordinates ``rho`` (pupil radius 1) "
"and ``theta`` (radians)."
msgstr ""

#: lumos.physics.zernike.zernike_basis:1 of
msgid ""
"Sample modes 1 … ``n_modes`` on ``grid`` over a pupil of ``diameter`` "
"centred on the origin."
msgstr ""

#: lumos.physics.zernike.zernike_basis:3 of
msgid ""
"Returns a NumPy array of shape ``(n_modes, ny, nx)``, zero outside the "
"pupil (``r > diameter / 2``)."
msgstr ""

#: lumos.physics.turbulence:1 of
msgid "Atmospheric turbulence: von Kármán spectrum and random phase screens."
msgstr ""

#: lumos.physics.turbulence:3 of
msgid ""
"The phase of a wave crossing Kolmogorov turbulence of Fried parameter "
":math:`r_0` has the power spectral density (Noll 1976, JOSA 66, 207; "
"Roddier 1981, *Progress in Optics* 19, §3.5.2), with the outer scale "
":math:`L_0` of the von Kármán model,"
msgstr ""

#: lumos.physics.turbulence:7 of
#, python-brace-format
msgid ""
"\\Phi(f) = 0.023\\, r_0^{-5/3} \\left(f^2 + L_0^{-2}\\right)^{-11/6} "
"\\quad \\mathrm{rad^2\\,m^2},\n"
"\n"
msgstr ""

#: lumos.physics.turbulence:9 of
#, python-brace-format
msgid ""
"and the structure function :math:`D(r) = 6.88\\,(r / r_0)^{5/3}` for "
":math:`L_0 \\to \\infty`. The Fried parameter scales with wavelength as "
":math:`r_0 \\propto \\lambda^{6/5}` (the optical path is achromatic), and"
" layers of fractional :math:`C_n^2` weights :math:`w_i` have "
":math:`r_{0,i} = r_0\\, w_i^{-3/5}`."
msgstr ""

#: lumos.physics.turbulence:13 of
msgid ""
"Screens are drawn in Fourier space (McGlamery 1976): one random complex "
"amplitude per frequency cell of a periodic grid, plus levels of "
"subharmonics that restore the low frequencies the grid misses (Lane, "
"Glindemann & Dainty 1992, *Waves in Random Media* 2, 209). Because "
":math:`\\Phi` is steep near the origin, the variance of each cell close "
"to it is the integral of :math:`\\Phi` over the cell rather than its "
"value at the centre (Johansson & Gavel 1994, Proc. SPIE 2200), and the "
"subharmonics go down to the outer scale. Even the smallest lags of the "
"structure function depend on these large scales: with three levels only, "
":math:`D(r)` is 10 to 20 % too low. A :class:`ScreenSpectrum` keeps the "
"amplitudes, so the screen can be evaluated at any translation, exactly "
"(Taylor's frozen flow)."
msgstr ""

#: lumos.physics.turbulence.ScreenSpectrum:1 of
msgid ""
"Random Fourier amplitudes of a phase screen of ``n × n`` pixels of side "
"``dx`` (SI units)."
msgstr ""

#: lumos.physics.turbulence.ScreenSpectrum:3 of
msgid ""
"The high frequencies are FFT amplitudes on the periodic grid; the low "
"frequencies (the cells close to the origin and the subharmonics) are "
"explicit sinusoids. Build it with :meth:`draw`; :meth:`evaluate` returns "
"the phase (rad) on the grid, translated by a shift."
msgstr ""

#: lumos.physics.turbulence.ScreenSpectrum.draw:1 of
msgid ""
"Draw the amplitudes of a screen of Fried parameter ``r0`` and outer scale"
" ``outer_scale``."
msgstr ""

#: lumos.physics.turbulence.ScreenSpectrum.draw:3 of
msgid ""
"``subharmonics`` is the number of subharmonic levels; ``None`` goes down "
"to the outer scale."
msgstr ""

#: lumos.physics.turbulence.ScreenSpectrum.evaluate:1 of
msgid ""
"Return the phase screen (rad) at the pixel coordinates ``(i - n // 2) "
"dx``, translated."
msgstr ""

#: lumos.physics.turbulence.ScreenSpectrum.evaluate:3 of
#, python-brace-format
msgid ""
"The value at :math:`\\mathbf{x}` is the value of the untranslated screen "
"at :math:`\\mathbf{x} - \\mathbf{s}`, with :math:`\\mathbf{s}` = "
"``(shift_x, shift_y)``."
msgstr ""

#: lumos.physics.turbulence.von_karman_psd:1 of
msgid ""
"Phase power spectral density of von Kármán turbulence (rad² m², radians "
"omitted)."
msgstr ""

#: lumos.physics.turbulence.von_karman_psd_si:1 of
msgid ""
"Phase power spectral density in rad² m² at spatial frequencies ``f`` "
"(m⁻¹); SI floats."
msgstr ""

#: lumos.physics.coronagraphy:1 of
msgid ""
"Focal-plane masks of coronagraphs: pupil → focal plane → mask → Lyot "
"plane."
msgstr ""

#: lumos.physics.coronagraphy:3 of
msgid ""
"With pupil coordinates :math:`\\tilde{\\mathbf{x}} = \\mathbf{x}/D` and "
"focal coordinates :math:`\\mathbf{u}` in units of :math:`\\lambda/D`, the"
" field after a focal-plane mask :math:`M(\\mathbf{u})` is, back in the "
"pupil (Lyot) plane,"
msgstr ""

#: lumos.physics.coronagraphy:7 of
msgid ""
"P'(\\tilde{\\mathbf{x}}) = \\int M(\\mathbf{u})\\, E(\\mathbf{u})\\,\n"
"e^{2i\\pi\\,\\tilde{\\mathbf{x}}\\cdot\\mathbf{u}}\\,d^2u, \\qquad\n"
"E(\\mathbf{u}) = \\int P(\\tilde{\\mathbf{x}})\\, "
"e^{-2i\\pi\\,\\tilde{\\mathbf{x}}\\cdot\\mathbf{u}}\\,d^2\\tilde{x}.\n"
"\n"
msgstr ""

#: lumos.physics.coronagraphy:12 of
#, python-brace-format
msgid ""
"Masks such as vortices and quadrant phase masks cover the whole focal "
"plane and are singular at its centre, so the integral is split with "
"smooth radial windows :math:`W_k` (1 inside :math:`a_k`, 0 outside "
":math:`b_k`, raised cosine between): a zero-padded FFT computes the part "
":math:`M (1 - W_0)` of the whole plane, and matrix Fourier transforms "
"(Soummer et al. 2007, Opt. Express 15, 15935) of finer and finer sampling"
" compute the parts :math:`M (W_{k-1} - W_k)` and :math:`M W_{K}` near the"
" axis. This multi-scale scheme follows the one used for vortex "
"coronagraphs by Krist et al. (2012, Proc. SPIE 8151). The residual of "
"ideal masks is then set by the sampling of the pupil (it decreases as "
":math:`1/N^2` for :math:`N` samples across the pupil), not by the focal-"
"plane computation."
msgstr ""

#: lumos.physics.coronagraphy.DEFAULT_LEVELS:1 of
msgid ""
"(inner radius, outer radius, sampling) of the windows of the fine levels,"
" in λ/D."
msgstr ""

#: lumos.physics.coronagraphy.lyot_plane:1 of
msgid "Return the field in the Lyot plane, on the same samples as ``field``."
msgstr ""

#: lumos.physics.coronagraphy.lyot_plane:3 of
msgid ""
"Complex pupil field, shape ``(..., ny, nx)``, on the uniform pupil "
"coordinates ``x`` and ``y``, in units of the pupil diameter (``x / D``)."
msgstr ""

#: lumos.physics.coronagraphy.lyot_plane:5 of
msgid ""
"Focal-plane transmission ``mask(ux, uy)`` for coordinates in λ/D (arrays "
"of the same shape)."
msgstr ""

#: lumos.physics.coronagraphy.lyot_plane:6 of
msgid ""
"Zero-padding factor of the coarse FFT (its sampling is ``1 / (pad n dx)``"
" λ/D)."
msgstr ""

#: lumos.physics.coronagraphy.lyot_plane:7 of
msgid ""
"``(inner, outer, sampling)`` of the windows and of the finer levels, from"
" the outside in."
msgstr ""

#: lumos.physics.coronagraphy.window:1 of
msgid ""
"Radial window: 1 for ``r <= inner``, 0 for ``r >= outer``, a raised "
"cosine between."
msgstr ""

#: lumos.physics.fibers:1 of
msgid ""
"Linearly polarised (LP) modes of weakly guiding step-index fibres (Gloge "
"1971, Appl. Opt. 10, 2252)."
msgstr ""

#: lumos.physics.fibers:3 of
msgid ""
"A fibre of core radius :math:`a`, numerical aperture :math:`\\mathrm{NA} "
"= \\sqrt{n_\\mathrm{co}^2 - n_\\mathrm{cl}^2}` has the normalised "
"frequency :math:`V = 2\\pi a\\,\\mathrm{NA}/\\lambda`. Mode "
":math:`\\mathrm{LP}_{\\ell m}` has the transverse field (with "
":math:`\\rho = r/a`)"
msgstr ""

#: lumos.physics.fibers:7 of
#, python-brace-format
msgid ""
"\\psi(\\rho, \\phi) = \\begin{cases} J_\\ell(U\\rho)/J_\\ell(U) & \\rho "
"\\le 1 \\\\\n"
"K_\\ell(W\\rho)/K_\\ell(W) & \\rho > 1 \\end{cases} \\times "
"\\begin{cases} \\cos \\ell\\phi \\\\ \\sin \\ell\\phi\n"
"\\end{cases},\n"
"\n"
msgstr ""

#: lumos.physics.fibers:12 of
msgid "where :math:`U` is the :math:`m`-th root of the characteristic equation"
msgstr ""

#: lumos.physics.fibers:14 of
msgid ""
"U \\frac{J_{\\ell-1}(U)}{J_\\ell(U)} = -W "
"\\frac{K_{\\ell-1}(W)}{K_\\ell(W)}, \\qquad U^2 + W^2 = V^2,\n"
"\n"
msgstr ""

#: lumos.physics.fibers:16 of
#, python-brace-format
msgid ""
"solved here in the pole-free form :math:`U J_{\\ell-1}(U) K_\\ell(W) + W "
"K_{\\ell-1}(W) J_\\ell(U) = 0`. The normalised propagation constant "
":math:`b = W^2/V^2` gives the effective index :math:`n_\\mathrm{eff}^2 = "
"n_\\mathrm{cl}^2 + b\\,\\mathrm{NA}^2`. A mode is guided above its "
"cutoff, a zero of :math:`J_{\\ell-1}` (:math:`J_1` for :math:`\\ell = "
"0`)."
msgstr ""

#: lumos.physics.fibers:21 of
#, python-brace-format
msgid ""
"The Gaussian approximation of LP01 has the waist :math:`w/a = 0.65 + "
"1.619 V^{-3/2} + 2.879 V^{-6}` (Marcuse 1977, Bell Syst. Tech. J. 56, "
"703)."
msgstr ""

#: lumos.physics.fibers.LPMode:1 of
msgid ""
"Guided mode LP(ell, m) at the normalised frequency ``v``, with the roots "
"``u`` and ``w``."
msgstr ""

#: lumos.physics.fibers.LPMode.b:1 of
msgid "Normalised propagation constant ``W² / V²``."
msgstr ""

#: lumos.physics.fibers.LPMode.label:1 of
msgid "Name of the mode, e.g. ``\"LP11\"``."
msgstr ""

#: lumos.physics.fibers.lp_modes:1 of
msgid ""
"Return the guided LP modes at the normalised frequency ``v``, by "
"decreasing propagation constant."
msgstr ""

#: lumos.physics.fibers.lp_radial:1 of
msgid ""
"Radial profile of ``mode`` at ``rho = r / a`` (1 at the core-cladding "
"interface)."
msgstr ""

#: lumos.physics.fibers.marcuse_waist:1 of
msgid ""
"Waist of the Gaussian approximation of LP01 in units of the core radius "
"(Marcuse 1977)."
msgstr ""

#: lumos.physics.photonics:1 of
msgid "Planar waveguides and multimode interference (MMI) couplers."
msgstr ""

#: lumos.physics.photonics:4 of
msgid "Mode solver"
msgstr ""

#: lumos.physics.photonics:5 of
#, python-brace-format
msgid ""
"Integrated components are reduced to two dimensions with the effective "
"index method: a slab of width :math:`W` and index :math:`n_\\mathrm{co}` "
"in a cladding :math:`n_\\mathrm{cl}` guides TE modes "
":math:`E(x)\\,e^{i\\beta z}` solving"
msgstr ""

#: lumos.physics.photonics:9 of
#, python-brace-format
msgid ""
"\\frac{d^2 E}{dx^2} + k^2 n(x)^2 E = \\beta^2 E ,\n"
"\n"
msgstr ""

#: lumos.physics.photonics:11 of
#, python-brace-format
msgid ""
"discretised here with second-order finite differences on a uniform grid "
"with zero field at its edges (the window is several times wider than the "
"guide). Guided modes have :math:`k n_\\mathrm{cl} < \\beta < k "
"n_\\mathrm{co}`; for a symmetric step-index slab they obey "
":math:`\\tan(\\kappa W/2) = \\gamma/\\kappa` (even) or "
":math:`-\\cot(\\kappa W/2) = \\gamma/\\kappa` (odd), with "
":math:`\\kappa^2 = k^2 n_\\mathrm{co}^2 - \\beta^2` and :math:`\\gamma^2 "
"= \\beta^2 - k^2 n_\\mathrm{cl}^2` (Marcuse, *Theory of Dielectric "
"Optical Waveguides*, §1.3)."
msgstr ""

#: lumos.physics.photonics:18 of
msgid "Multimode interference"
msgstr ""

#: lumos.physics.photonics:19 of
#, python-brace-format
msgid ""
"The field launched by an access waveguide into the multimode section is "
"expanded on the guided modes :math:`\\psi_m` of the section, propagated "
"as :math:`\\sum_m c_m \\psi_m e^{i\\beta_m L}` and projected on the modes"
" of the output waveguides (radiation modes are neglected): this gives the"
" scattering matrix of the component at each wavelength. Self-images form "
"at multiples of the beat length :math:`L_\\pi = \\pi / (\\beta_0 - "
"\\beta_1)`; an :math:`N \\times N` coupler with ports at :math:`x_i = W_e"
" (2i + 1 - N) / 2N` (:func:`effective_width`) makes :math:`N` images of "
"equal power at :math:`L = 3 L_\\pi / N` (Soldano & Pennings 1995, J. "
"Lightwave Technol. 13, 615; Bachmann, Besse & Melchior 1994, Appl. Opt. "
"33, 3905)."
msgstr ""

#: lumos.physics.photonics.SlabModes:1 of
msgid ""
"Guided TE modes of a slab: propagation constants ``beta`` (rad/m) and "
"fields ``(n_modes, nx)``."
msgstr ""

#: lumos.physics.photonics.SlabModes:3 of
msgid "Fields are real and normalised so that ``sum(field**2) * dx = 1``."
msgstr ""

#: lumos.physics.photonics.SlabModes.dx:1 of
msgid "Sampling step of the fields."
msgstr ""

#: lumos.physics.photonics.beat_length:1 of
msgid ""
"Beat length ``π / (β0 - β1)`` of the two first modes of the multimode "
"section."
msgstr ""

#: lumos.physics.photonics.effective_width:1 of
msgid ""
"Return the effective width ``W + (λ/π) (n_co² - n_cl²)^(-1/2)`` of a TE "
"multimode section."
msgstr ""

#: lumos.physics.photonics.effective_width:3 of
msgid ""
"The Goos-Hänchen penetration of the modes in the cladding widens the "
"section (Soldano & Pennings 1995)."
msgstr ""

#: lumos.physics.photonics.mmi_matrix:1 of
msgid ""
"Scattering matrix ``(n_out, n_in)`` of a multimode interference coupler "
"at ``wavelength``."
msgstr ""

#: lumos.physics.photonics.port_positions:1 of
msgid ""
"Positions of ``n`` equally spaced ports of the general-interference "
"coupler (centre at 0)."
msgstr ""

#: lumos.physics.photonics.slab_modes:1 of
msgid ""
"Return the guided TE modes of the index profile ``index`` sampled on the "
"uniform grid ``x``."
msgstr ""

#: ../../api/index.md:185
msgid "Elements"
msgstr ""

#: lumos.elements:1 of
msgid "Library of elements (§5.9)."
msgstr ""

#: lumos.elements:3 of
msgid ""
"Sources, apertures, optics, telescopes, atmosphere, coronagraphs, guided "
"and integrated optics, buses (Demux, Mux), detectors and laboratory "
"equipment."
msgstr ""

#: lumos.elements:6 of
msgid ""
"Importing this package registers every built-in element type in "
":data:`lumos.core.registry.registry`, so that ``.lumos`` files can refer "
"to them by their stable identifiers (``lumos.<family>.<Name>``)."
msgstr ""

#: lumos.elements.sources:1 of
msgid "Point, astronomical and laboratory sources (REQ-SCN-2, §5.9)."
msgstr ""

#: lumos.elements.sources:3 of
msgid ""
"Sources at infinity (:class:`PointSource`, :class:`Star`, "
":class:`PlanetarySystem`) produce a :class:`~lumos.fields.SourceList` "
"sampled at the spectral channels of the context "
"(``ctx.observation.band``); a telescope then samples their plane waves on"
" its pupil. Laboratory sources emit fields on their own grid: "
":class:`GaussianLaser` a coherent :class:`~lumos.fields.Wavefront`, "
":class:`IncoherentLamp` a :class:`~lumos.fields.RadianceField`."
msgstr ""

#: lumos.elements.sources:10 of
msgid "Physics"
msgstr ""

#: lumos.elements.sources:11 of
msgid ""
"A star of radius :math:`R`, temperature :math:`T` and distance :math:`d` "
"has the flux density :math:`F_\\lambda = \\pi B_\\lambda(T) (R/d)^2` "
"(Rybicki & Lightman §1.4); given a magnitude, the blackbody shape is "
"scaled so that :math:`F_\\nu` at the effective wavelength of the band "
"matches the zero point (:mod:`lumos.physics.photometry`)."
msgstr ""

#: lumos.elements.sources:15 of
#, python-brace-format
msgid ""
"A planet at distance :math:`r` from its star reflects :math:`F_\\star A_g"
" \\Phi(\\alpha) (R_p/r)^2` (geometric albedo :math:`A_g`, Lambert phase "
"function, phase angle :math:`\\alpha`) and emits as a blackbody at its "
"equilibrium temperature :math:`T_\\mathrm{eq} = T_\\star \\sqrt{R_\\star "
"/ 2r}\\,(1 - A)^{1/4}` (the albedo is used as the Bond albedo)."
msgstr ""

#: lumos.elements.sources:19 of
msgid ""
"A Lambertian lamp of radiance :math:`L` and area :math:`A` emits :math:`P"
" = \\pi L A` (Lambert's law)."
msgstr ""

#: lumos.elements.sources.GaussianLaser:1 of
msgid "Laser beam with a Gaussian profile at its waist, sampled on its own grid."
msgstr ""

#: lumos.elements.sources.GaussianLaser.transfer:1 of
msgid "Return the beam at its waist."
msgstr ""

#: lumos.elements.sources.IncoherentLamp:1 of
msgid "Uniform Lambertian disk with a flat spectrum over the band of the context."
msgstr ""

#: lumos.elements.sources.IncoherentLamp.transfer:1 of
msgid "Return the radiance of the lamp."
msgstr ""

#: lumos.elements.sources.Planet:1 of
msgid ""
"A planet on a Keplerian orbit around its star (the star itself is not "
"emitted)."
msgstr ""

#: lumos.elements.sources.Planet:3 of
msgid ""
"Use it with a :class:`Star` for systems of several planets "
"(:meth:`lumos.scenes.Scene.from_catalog`)."
msgstr ""

#: lumos.elements.sources.Planet.transfer:1 of
msgid "Return the planet at the current time."
msgstr ""

#: lumos.elements.sources.Planet.from_catalog:1 of
msgid ""
"Create the planet ``name`` from the NASA Exoplanet Archive (or from an "
"exoplanet ``record``)."
msgstr ""

#: lumos.elements.sources.Planet.from_catalog:3 of
msgid "Missing parameters keep their defaults; ``values`` override the catalogue."
msgstr ""

#: lumos.elements.sources.PlanetarySystem:1 of
msgid ""
"A star and one planet on a Keplerian orbit; the planet moves with the "
"context clock."
msgstr ""

#: lumos.elements.sources.PlanetarySystem.transfer:1 of
msgid "Return the star and the planet at the current time."
msgstr ""

#: lumos.elements.sources.PointSource:1 of
msgid "Unresolved source at infinity with a flat spectral flux density ``F_ν``."
msgstr ""

#: lumos.elements.sources.PointSource.transfer:1 of
msgid "Return the source list of the point source."
msgstr ""

#: lumos.elements.sources.Star:1 of
msgid ""
"Blackbody star, scaled by its radius and distance or by a magnitude in a "
"photometric band."
msgstr ""

#: lumos.elements.sources.Star.transfer:1 of
msgid "Return the source list of the star."
msgstr ""

#: lumos.elements.sources.Star.from_catalog:1 of
msgid "Create the star ``name`` from SIMBAD (or from a star ``record``)."
msgstr ""

#: lumos.elements.sources.Star.from_catalog:3 of
msgid ""
"The temperature is the catalogue effective temperature; the flux is "
"scaled to the V magnitude when it is known (else to the radius and "
"distance). The distance comes from the parallax. ``values`` override the "
"catalogue."
msgstr ""

#: lumos.elements.apertures:1 of
msgid "Apertures and pupils (§5.9, step P6.2)."
msgstr ""

#: lumos.elements.apertures:3 of
msgid ""
"An aperture element multiplies the optical signal it receives by its "
"amplitude transmission, computed on the grid of the signal with anti-"
"aliased edges (:mod:`lumos.physics.apertures`): wavefronts, wavecubes and"
" incoherent bundles are multiplied by the mask, radiance fields by its "
"square (a power transmission)."
msgstr ""

#: lumos.elements.apertures:7 of
msgid "Presets give approximate geometric models of telescope pupils:"
msgstr ""

#: lumos.elements.apertures:9 of
msgid ""
":func:`vlt`: 8.2 m primary, 1.116 m central obstruction, four 5 cm spider"
" vanes (ESO VLT User Manual);"
msgstr ""

#: lumos.elements.apertures:10 of
msgid ""
":func:`jwst`: 18 hexagonal segments of 1.32 m flat to flat with 7 mm gaps"
" (Gardner et al. 2023), without the secondary supports;"
msgstr ""

#: lumos.elements.apertures:12 of
msgid ""
":func:`elt`: 798 hexagonal segments of 1.4 m corner to corner with 4 mm "
"gaps between radii 4.75 m and 19.65 m (39.3 m tip to tip; ESO ELT "
"Construction Proposal 2011), six 50 cm spider vanes."
msgstr ""

#: lumos.elements.apertures.Aperture:1 of
msgid "Base class of apertures: a mask applied to the incoming optical signal."
msgstr ""

#: lumos.elements.apertures.Aperture.mask:1 of
msgid ""
"Amplitude transmission of the aperture sampled on ``grid`` (NumPy array, "
"values in [0, 1])."
msgstr ""

#: lumos.elements.apertures.CircularAperture:1 of
msgid ""
"Circular pupil with an optional central obstruction and radial spider "
"vanes."
msgstr ""

#: lumos.elements.apertures._transfer.<locals>.transfer:1 of
msgid ""
"Multiply the incoming signal by the amplitude transmission of the "
"aperture."
msgstr ""

#: lumos.elements.apertures.CircularAperture.transfer_symbolic:1 of
msgid ""
"Multiply a symbolic field by the indicator of the annulus (no closed form"
" with spiders)."
msgstr ""

#: lumos.elements.apertures.HexSegmentedAperture:1 of
msgid ""
"Primary made of hexagonal segments on a hexagonal lattice, ring by ring "
"around the centre."
msgstr ""

#: lumos.elements.apertures.HexSegmentedAperture.segment_count:1 of
msgid ""
"Return the number of segments of the primary (independent of the sampling"
" ``grid``)."
msgstr ""

#: lumos.elements.apertures.HexSegmentedAperture.diameter:1 of
msgid "Tip-to-tip diameter of the primary."
msgstr ""

#: lumos.elements.apertures.PolygonAperture:1 of
msgid "Regular polygon (e.g. a hexagonal segment) inscribed in a circle."
msgstr ""

#: lumos.elements.apertures.elt:1 of
msgid "Approximate primary of the Extremely Large Telescope (798 segments)."
msgstr ""

#: lumos.elements.apertures.jwst:1 of
msgid "Approximate primary of the James Webb Space Telescope (18 segments)."
msgstr ""

#: lumos.elements.apertures.vlt:1 of
msgid "Approximate pupil of a VLT unit telescope."
msgstr ""

#: lumos.elements.optics:1 of
msgid "Bulk optics (§5.9, step P6.3)."
msgstr ""

#: lumos.elements.optics:3 of
msgid ""
"Free space, thin lenses and mirrors, beam splitters, filters, delay "
"lines, polarisers, wave plates and Zernike phase plates. Every element "
"acts on :class:`~lumos.fields.Wavefront`, :class:`~lumos.fields.Wavecube`"
" and :class:`~lumos.fields.IncoherentBundle` signals (REQ-EL-8), channel "
"by channel for polychromatic light and mode by mode for bundles; the "
"spectral filter also acts on :class:`~lumos.fields.RadianceField` "
"signals."
msgstr ""

#: lumos.elements.optics:10 of
msgid "Conventions and physics"
msgstr ""

#: lumos.elements.optics:11 of
msgid ""
"Fields evolve as :math:`\\exp[i(kz - \\omega t)]`: a vacuum path "
"difference :math:`d` multiplies the field by :math:`\\exp(2i\\pi d / "
"\\lambda)` (:class:`DelayLine`)."
msgstr ""

#: lumos.elements.optics:13 of
msgid ""
"A thin lens of focal length :math:`f` multiplies the field by "
":math:`\\exp(-ik r^2 / 2f)` (Goodman, *Introduction to Fourier Optics*, "
"§5.1), with :math:`r` measured from the origin of the grid coordinates. A"
" thin mirror is modelled *unfolded*: a spherical mirror of focal length "
":math:`f = R/2` acts like the lens of the same focal length on the field "
"travelling along the folded axis."
msgstr ""

#: lumos.elements.optics:17 of
#, python-brace-format
msgid ""
"A lossless beam splitter of power reflectance :math:`R` has the amplitude"
" coefficients :math:`t = \\sqrt{1 - R}` and :math:`r = i\\sqrt{R}`, which"
" make its scattering matrix unitary (Saleh & Teich, *Fundamentals of "
"Photonics*, §13.1)."
msgstr ""

#: lumos.elements.optics:20 of
#, python-brace-format
msgid ""
"A spectral filter has a top-hat power transmission :math:`T` for "
":math:`|\\lambda - \\lambda_0| \\le \\Delta\\lambda / 2` (amplitude "
":math:`\\sqrt{T}`) and blocks the other channels."
msgstr ""

#: lumos.elements.optics:22 of
msgid ""
"Polarisers and wave plates apply the Jones matrices of "
":mod:`lumos.fields.jones` (Hecht, *Optics*, §8)."
msgstr ""

#: lumos.elements.optics.BeamSplitter:1 of
#, python-brace-format
msgid ""
"Lossless beam splitter: :math:`t = \\sqrt{1 - R}` (transmitted), :math:`r"
" = i\\sqrt{R}` (reflected)."
msgstr ""

#: lumos.elements.optics.BeamSplitter.transfer:1 of
msgid "Split the incoming light in two beams."
msgstr ""

#: lumos.elements.optics.BeamSplitter.transfer_symbolic:1 of
#, python-brace-format
msgid ""
"Split a symbolic field: :math:`i\\sqrt{R}\\,U` and :math:`\\sqrt{1 - "
"R}\\,U`."
msgstr ""

#: lumos.elements.optics.DelayLine:1 of
msgid ""
"Vacuum optical path delay :math:`d`: multiplies each channel by "
":math:`\\exp(2i\\pi d / \\lambda)`."
msgstr ""

#: lumos.elements.optics.DelayLine.transfer:1 of
msgid "Apply the chromatic phase of the delay."
msgstr ""

#: lumos.elements.optics.DelayLine.transfer_symbolic:1 of
msgid "Multiply a symbolic field by :math:`\\exp(2i\\pi d / \\lambda)`."
msgstr ""

#: lumos.elements.optics.FreeSpace:1 of
msgid ""
"Propagation in vacuum over a distance, with the methods of "
":func:`lumos.propagation.propagate`."
msgstr ""

#: lumos.elements.optics.FreeSpace.transfer:1 of
msgid "Propagate the incoming field to the output plane."
msgstr ""

#: lumos.elements.optics.FreeSpace.transfer_symbolic:1 of
msgid ""
"Propagate a symbolic field: closed form when known, logged numerical "
"fallback otherwise."
msgstr ""

#: lumos.elements.optics.PhasePlate:1 of
msgid ""
"Phase plate adding the OPD ``Σ a_j Z_j`` (Noll's Zernike modes, j from 1)"
" over a disk."
msgstr ""

#: lumos.elements.optics.PhasePlate.opd:1 of
msgid ""
"Return the optical path difference of the plate on ``grid`` (zero outside"
" the disk)."
msgstr ""

#: lumos.elements.optics.PhasePlate.transfer:1 of
msgid "Add the optical path of the plate to every channel and mode."
msgstr ""

#: lumos.elements.optics.Polarizer:1 of
msgid "Ideal linear polariser transmitting the polarisation at ``angle`` from +x."
msgstr ""

#: lumos.elements.optics.Polarizer.transfer:1 of
msgid "Apply the Jones matrix of the polariser."
msgstr ""

#: lumos.elements.optics.SpectralFilter:1 of
msgid ""
"Top-hat band-pass filter: power transmission inside the band, opaque "
"outside."
msgstr ""

#: lumos.elements.optics.SpectralFilter.transfer:1 of
msgid "Keep the channels inside the band."
msgstr ""

#: lumos.elements.optics.SpectralFilter.transfer_symbolic:1 of
msgid ""
"Multiply a symbolic field by the amplitude transmission of the band "
"(``Piecewise`` in λ)."
msgstr ""

#: lumos.elements.optics.ThinLens:1 of
msgid ""
"Thin lens: multiplies the field by :math:`\\exp(-ik r^2 / 2f)` "
"(converging for :math:`f > 0`)."
msgstr ""

#: lumos.elements.optics.ThinLens.transfer:1 of
msgid "Apply the quadratic phase of the lens."
msgstr ""

#: lumos.elements.optics.ThinMirror:1 of
msgid ""
"Thin spherical mirror of focal length ``R / 2``, modelled unfolded as the"
" equivalent thin lens."
msgstr ""

#: lumos.elements.optics.ThinMirror.transfer:1 of
msgid "Apply the quadratic phase of the mirror."
msgstr ""

#: lumos.elements.optics.WavePlate:1 of
msgid ""
"Linear retarder with its fast axis at ``angle`` (a ``retardance`` of 180°"
" makes a half-wave plate)."
msgstr ""

#: lumos.elements.optics.WavePlate.transfer:1 of
msgid "Apply the Jones matrix of the retarder."
msgstr ""

#: lumos.elements.optics.chromatic_factor:1 of
msgid ""
"Multiply every spectral channel of ``signal`` by ``factor(wavelengths, "
"xp)``."
msgstr ""

#: lumos.elements.optics.chromatic_factor:3 of
msgid "Wavefront, wavecube or bundle."
msgstr ""

#: lumos.elements.optics.chromatic_factor:4 of
msgid ""
"Function of the vacuum wavelengths (a backend array of shape ``(nλ, 1, "
"1)``, in metres) and of the array namespace, returning a transmission "
"broadcastable to ``(nλ, ny, nx)``."
msgstr ""

#: lumos.elements.telescopes:1 of
msgid "Telescopes and telescope arrays (§5.9, step P6.4)."
msgstr ""

#: lumos.elements.telescopes:3 of
msgid ""
"A :class:`Telescope` turns the sources at infinity it receives "
"(:class:`~lumos.fields.SourceList`) into the plane waves sampled on its "
"pupil, one mode of an :class:`~lumos.fields.IncoherentBundle` per source:"
" channel :math:`k` of source :math:`m` is"
msgstr ""

#: lumos.elements.telescopes:7 of
msgid ""
"U_{mk}(x, y) = \\sqrt{F_{mk} b_k}\\; P(x, y)\\, "
"\\exp\\!\\left[\\frac{2i\\pi}{\\lambda_k}\n"
"(x\\,\\theta_{x,m} + y\\,\\theta_{y,m})\\right],\n"
"\n"
msgstr ""

#: lumos.elements.telescopes:10 of
#, python-brace-format
msgid ""
"with :math:`P` the anti-aliased pupil transmission, so that the power of "
"each channel is the photon rate :math:`A F_{mk} b_k` collected by the "
"pupil area :math:`A` (``photon / s``). Since grey edge pixels transmit "
"the power :math:`P^2 < P`, the pupil is scaled so that :math:`\\sum P^2 "
"\\Delta x \\Delta y` equals the anti-aliased area :math:`\\sum P \\Delta "
"x \\Delta y`, which converges to the exact area."
msgstr ""

#: lumos.elements.telescopes:15 of
msgid ""
"A :class:`TelescopeArray` models an interferometer collecting the light "
"in free space: it returns a :class:`~lumos.fields.Bus` of "
":class:`~lumos.fields.IncoherentBundle` in the pupil plane, one lane per "
"telescope (``T1``... ``Tn``, with the projected positions of the "
"telescopes, ADR-0023). Lane :math:`j` is the pupil of a "
":class:`Telescope` with the geometric phase of its arm,"
msgstr ""

#: lumos.elements.telescopes:20 of
#, python-brace-format
msgid ""
"U_{jmk}(x, y) = U_{mk}(x, y)\\, \\exp\\!\\left[\\frac{2i\\pi}{\\lambda_k}"
"\n"
"(u_j\\,\\theta_{x,m} + v_j\\,\\theta_{y,m})\\right],\n"
"\n"
msgstr ""

#: lumos.elements.telescopes:23 of
msgid ""
"the geometric delay of the phase centre being compensated by the delay "
"lines. The injection into guides is an explicit element: a "
":class:`~lumos.elements.fibers.Fiber` with an ``injection_focal_length`` "
"acts on every lane of the bus, with the real coupling efficiency (about "
"81 % at best for a circular pupil) and the antenna lobe of the fibre "
"(Shaklan & Roddier 1988, Appl. Opt. 27, 2334); ``Demux`` lets each arm "
"have its own optics first."
msgstr ""

#: lumos.elements.telescopes:29 of
msgid ""
":class:`IdealInjectionArray` is the fast analytic model, useful for many "
"sources (an exozodiacal disc of thousands of points): every telescope "
"delivers to a single-mode guide the amplitude"
msgstr ""

#: lumos.elements.telescopes:32 of
msgid ""
"a_{mkj} = \\sqrt{\\eta A F_{mk} b_k}\\; "
"\\exp\\!\\left[\\frac{2i\\pi}{\\lambda_k}\n"
"(u_j\\,\\theta_{x,m} + v_j\\,\\theta_{y,m})\\right]\n"
"\n"
msgstr ""

#: lumos.elements.telescopes:35 of
msgid ""
"(a bus of single-mode guided lanes, :math:`\\eta` the throughput), "
"without coupling loss nor antenna lobe. Angles are direction cosines on "
"the sky, :math:`\\theta_x` towards the East (u) and :math:`\\theta_y` "
"towards the North (v)."
msgstr ""

#: lumos.elements.telescopes:39 of
msgid ""
"A :class:`FizeauCombiner` recombines such a bus in **one** output pupil: "
"each lane is placed at the projected position of its telescope, at the "
"scale of the input pupils (a homothetic exit pupil, Traub 1986, J. Opt. "
"Soc. Am. A 3, 1491), so that the field of a source is one plane wave "
"across the output pupil and the image keeps a wide field. Sub-pixel "
"positions are reached by a Fourier shift of each lane, which conserves "
"its power. The propagation elements then bring the output pupil to a "
"focal plane, where two apertures give the Airy pattern of one of them "
"modulated by Young fringes (Born & Wolf, *Principles of Optics*, §8.6)."
msgstr ""

#: lumos.elements.telescopes:47 of
msgid "Projected baselines"
msgstr ""

#: lumos.elements.telescopes:48 of
msgid ""
"In the ``\"ground\"`` frame, station positions are local (East, North, "
"Up) coordinates at the latitude :math:`\\varphi`. They are expressed in "
"the equatorial frame and projected on the plane of the sky of a target of"
" declination :math:`\\delta` at hour angle :math:`H` (Thompson, Moran & "
"Swenson, *Interferometry and Synthesis in Radio Astronomy*, 3rd ed., eqs."
" 4.15 and 4.1):"
msgstr ""

#: lumos.elements.telescopes:53 of
msgid ""
"X = -\\sin\\varphi\\,N + \\cos\\varphi\\,U, \\quad Y = E, \\quad Z = "
"\\cos\\varphi\\,N + \\sin\\varphi\\,U,\n"
"\n"
"u = \\sin H\\,X + \\cos H\\,Y, \\qquad v = -\\sin\\delta\\cos H\\,X + "
"\\sin\\delta\\sin H\\,Y + \\cos\\delta\\,Z ."
msgstr ""

#: lumos.elements.telescopes:58 of
msgid ""
"The hour angle grows with the context clock at the sidereal rate (one "
"turn per 86164.0905 s, IERS Conventions 2010). In the ``\"sky\"`` frame "
"(space arrays), positions are given in the plane of the sky and the array"
" rotates about the line of sight at ``rotation_rate``."
msgstr ""

#: lumos.elements.telescopes:62 of
msgid ""
"Presets: :func:`vlti` (the four 8.2 m unit telescopes of Paranal), "
":func:`life` (the four 2 m collectors of the LIFE X-array, Quanz et al. "
"2022, A&A 664, A21)."
msgstr ""

#: lumos.elements.telescopes.FizeauCombiner:1 of
msgid ""
"Recombine a bus of pupil-plane beams in one pupil, each beam at the "
"position of its telescope."
msgstr ""

#: lumos.elements.telescopes.FizeauCombiner.transfer:1 of
msgid "Place every lane at the position of its telescope and add the fields."
msgstr ""

#: lumos.elements.telescopes.IdealInjectionArray:1 of
msgid ""
"Array of identical telescopes injecting each beam in a single-mode guide "
"with an ideal coupling."
msgstr ""

#: lumos.elements.telescopes.IdealInjectionArray.transfer:1 of
msgid ""
"Return the bus of the amplitudes injected by every telescope for every "
"source and channel."
msgstr ""

#: lumos.elements.telescopes.Telescope:1 of
msgid ""
"Telescope pupil sampling the plane waves of the sources at infinity (one "
"bundle mode per source)."
msgstr ""

#: lumos.elements.telescopes.Telescope.pupil_grid:1 of
msgid "Return the sampling of the pupil."
msgstr ""

#: lumos.elements.telescopes.Telescope.transfer:1 of
msgid "Sample the plane waves of the received sources on the pupil."
msgstr ""

#: lumos.elements.telescopes.TelescopeArray:1 of
msgid ""
"Array of identical telescopes: a bus of the beams in their pupil planes, "
"one per telescope."
msgstr ""

#: lumos.elements.telescopes.TelescopeArray.transfer:1 of
msgid ""
"Sample the plane waves of the sources on every pupil, with the delay of "
"its arm."
msgstr ""

#: lumos.elements.telescopes.life:1 of
msgid ""
"Return the LIFE X-array: four 2 m collectors on a rectangle of 1 by 6 "
"nulling baselines."
msgstr ""

#: lumos.elements.telescopes.life:3 of
msgid ""
"LIFE adapts the nulling baseline (10 to 100 m) to each target (Quanz et "
"al. 2022); 15 m is an example."
msgstr ""

#: lumos.elements.telescopes.vlti:1 of
msgid ""
"Return the four 8.2 m unit telescopes of the VLTI at Paranal (other "
"fields passed in ``values``)."
msgstr ""

#: lumos.elements.atmosphere:1 of
msgid "Turbulent atmosphere and adaptive optics (§5.9, step P6.5)."
msgstr ""

#: lumos.elements.atmosphere:3 of
#, python-brace-format
msgid ""
":class:`Atmosphere` adds the optical path difference (OPD) of von Kármán "
"turbulence layers to the light it receives "
"(:mod:`lumos.physics.turbulence`). Each layer :math:`i` has a fraction "
":math:`w_i` of the turbulence (:math:`r_{0,i} = r_0 w_i^{-3/5}`) and is "
"carried by the wind at :math:`\\mathbf{v}_i` (Taylor's frozen flow: "
":math:`\\mathrm{OPD}_i(\\mathbf{x}, t) = \\mathrm{OPD}_i(\\mathbf{x} - "
"\\mathbf{v}_i t, 0)`, ``t`` from the context clock). The OPD is "
"achromatic, so every channel gets the phase "
":math:`2\\pi\\,\\mathrm{OPD}/\\lambda` and the Fried parameter scales as "
":math:`\\lambda^{6/5}` (Roddier 1981). Screens are drawn from the "
"reproducible random stream of the element in its context "
"(:attr:`~lumos.core.element.Element.stochastic`); the layers act in the "
"pupil plane (no scintillation)."
msgstr ""

#: lumos.elements.atmosphere:12 of
#, python-brace-format
msgid ""
"A simple adaptive optics correction is built in: ``corrected_modes = J`` "
"removes, over the pupil of diameter ``pupil_diameter``, the least-squares"
" projection of the OPD on Noll's modes 1 … J (an ideal wavefront sensor "
"and corrector), leaving the residual variance :math:`\\Delta_J "
"(D/r_0)^{5/3}` of Noll (1976)."
msgstr ""

#: lumos.elements.atmosphere:16 of
#, python-brace-format
msgid ""
":class:`DeformableMirror` is a grid of actuators with Gaussian influence "
"functions :math:`w(r) = c^{(r/p)^2}` (coupling :math:`c` at the pitch "
":math:`p`); its surface :math:`s = \\sum_k a_k w(\\mathbf{x} - "
"\\mathbf{x}_k)` changes the optical path by :math:`2s` (reflection). "
":meth:`DeformableMirror.fit` finds the commands whose OPD best fits a map"
" (least squares)."
msgstr ""

#: lumos.elements.atmosphere:21 of
#, python-brace-format
msgid ""
"A closed adaptive optics loop (ADR-0020) adds two elements. "
":class:`WavefrontSensor` is an ideal Shack-Hartmann sensor: in each "
"square sub-aperture of side :math:`w` it measures the mean gradient of "
"the optical path, :math:`\\langle \\partial_x \\mathrm{OPD} \\rangle`, "
"the tilt of the wavefront in radians (Hardy 1998, §5.3). The gradient of "
"each pixel comes from the phase difference of its neighbours, "
":math:`\\arg(E_{j+1} E_{j-1}^*)\\,\\lambda / (4\\pi\\,\\Delta x)`, so "
"wavefronts of many waves are measured as long as the phase changes by "
"less than π between two pixels; channels and polarisations are weighted "
"by their intensity. It also gives the RMS optical path over the "
"illuminated pupil, from the phase relative to the mean complex amplitude "
"(piston removed): exact while the residual stays below about λ/4. "
":class:`AOController` is an integrator: from the slopes ``s`` it computes"
" the correction :math:`\\Delta c = -g R s` of a deformable mirror of the "
"same geometry, with :math:`R = (D^T D + \\epsilon\\,\\sigma_{max}^2 "
"I)^{-1} D^T` the regularised pseudo-inverse of the interaction matrix "
":math:`D`. With separable Gaussian influence functions :math:`f_k(t) = "
"e^{-\\alpha (t - a_k)^2}`, :math:`\\alpha = -\\ln c / p^2`, the mean "
"slope of an actuator over a sub-aperture is separable: ``D_x = 2 (M_y ⊗ "
"K_x)`` with :math:`M` the mean of the influence over the sub-aperture "
"(error functions) and :math:`K` its difference across it divided by its "
"width (the factor 2 of reflection). Fed back to the mirror with "
"``ctx.feedback(\"ctrl.commands\", \"dm.commands\", mode=\"add\")`` and "
"run by ``ctx.loop``, the error of an aberration the mirror can reproduce "
"decreases as :math:`(1 - g)^k`."
msgstr ""

#: lumos.elements.atmosphere.AOController:1 of
msgid ""
"Integrator of an adaptive optics loop: command increments of a deformable"
" mirror from the slopes."
msgstr ""

#: lumos.elements.atmosphere.AOController.transfer:1 of
msgid "Compute ``Δc = -g R s`` from the valid slopes."
msgstr ""

#: lumos.elements.atmosphere.AOController.check_feedback:1 of
msgid ""
"Accept only the ``commands`` of a deformable mirror of the geometry of "
"the controller."
msgstr ""

#: lumos.elements.atmosphere.Atmosphere:1 of
msgid ""
"Multi-layer von Kármán turbulence in frozen flow, with an optional ideal "
"adaptive optics correction."
msgstr ""

#: lumos.elements.atmosphere.Atmosphere.opd:1 of
msgid "Return the optical path difference added on ``grid`` at the current time."
msgstr ""

#: lumos.elements.atmosphere.Atmosphere.transfer:1 of
msgid "Add the turbulent phase to every channel and mode."
msgstr ""

#: lumos.elements.atmosphere.DeformableMirror:1 of
msgid ""
"Square grid of actuators with Gaussian influence functions; the OPD is "
"twice the surface."
msgstr ""

#: lumos.elements.atmosphere.DeformableMirror.actuator_positions:1 of
msgid ""
"Positions ``(x, y)`` of the actuators in the order of the commands, shape"
" ``(n², 2)``."
msgstr ""

#: lumos.elements.atmosphere.DeformableMirror.opd:1 of
msgid "Return the optical path difference of the mirror on ``grid``."
msgstr ""

#: lumos.elements.atmosphere.DeformableMirror.fit:1 of
msgid ""
"Return the commands whose OPD fits ``opd`` (sampled on ``grid``) with "
"least squares."
msgstr ""

#: lumos.elements.atmosphere.DeformableMirror.transfer:1 of
msgid "Add the optical path of the mirror to every channel and mode."
msgstr ""

#: lumos.elements.atmosphere.WavefrontSensor:1 of
msgid ""
"Ideal Shack-Hartmann sensor: mean gradients of the optical path in sub-"
"apertures, RMS residual."
msgstr ""

#: lumos.elements.atmosphere.WavefrontSensor.transfer:1 of
msgid ""
"Measure the slopes in every sub-aperture and the RMS residual optical "
"path."
msgstr ""

#: lumos.elements.coronagraphs:1 of
msgid ""
"Coronagraphs (§5.9, step P6.6): four-quadrant phase mask, vortex and Lyot"
" coronagraphs."
msgstr ""

#: lumos.elements.coronagraphs:3 of
#, python-brace-format
msgid ""
"A coronagraph element receives the field in a pupil plane, where a pupil "
"of diameter ``pupil_diameter`` is centred on the coordinate origin. It "
"focuses the field, applies its focal-plane mask :math:`M(\\mathbf{u})` "
"(coordinates in :math:`\\lambda/D` at the wavelength of each channel), "
"returns to the next pupil plane and applies a circular Lyot stop of "
"diameter ``lyot_stop`` × ``pupil_diameter``. The output is the field just"
" after the Lyot stop, on the input grid "
"(:func:`lumos.physics.coronagraphy.lyot_plane`)."
msgstr ""

#: lumos.elements.coronagraphs:10 of
msgid "Masks"
msgstr ""

#: lumos.elements.coronagraphs:11 of
#, python-brace-format
msgid ""
":class:`VortexCoronagraph`: :math:`M = e^{il\\theta}` of topological "
"charge :math:`l`; even charges reject all the light of an on-axis source "
"in an unobstructed circular pupil (Mawet et al. 2005; Foo et al. 2005)."
msgstr ""

#: lumos.elements.coronagraphs:13 of
msgid ""
":class:`FourQuadrantPhaseMask`: phase 0 in the quadrants where :math:`u_x"
" u_y > 0` and :math:`\\pi` where :math:`u_x u_y < 0` (Rouan et al. 2000),"
" with the same perfect rejection."
msgstr ""

#: lumos.elements.coronagraphs:15 of
msgid ""
":class:`LyotCoronagraph`: opaque disk of radius ``mask_radius`` "
":math:`\\lambda_0/D`, a physical size that becomes "
":math:`m_0\\lambda_0/\\lambda` in units of :math:`\\lambda/D`; its edge "
"is anti-aliased."
msgstr ""

#: lumos.elements.coronagraphs:18 of
msgid ""
"Phase masks are achromatic by default (e.g. geometric-phase vector "
"vortices). With ``achromatic=False``, the phase delays are designed for "
"``reference_wavelength`` and scale as :math:`\\lambda_0/\\lambda`."
msgstr ""

#: lumos.elements.coronagraphs.Coronagraph:1 of
msgid ""
"Base class: focal-plane mask between two pupil planes, followed by a Lyot"
" stop."
msgstr ""

#: lumos.elements.coronagraphs.FourQuadrantPhaseMask:1 of
msgid ""
"Four-quadrant phase mask (π phase in two opposite quadrants) followed by "
"a Lyot stop."
msgstr ""

#: lumos.elements.coronagraphs.FourQuadrantPhaseMask.transfer:1 of
msgid "Return the field after the quadrant mask and the Lyot stop."
msgstr ""

#: lumos.elements.coronagraphs.LyotCoronagraph:1 of
msgid ""
"Opaque focal-plane disk (classical Lyot coronagraph) followed by a Lyot "
"stop."
msgstr ""

#: lumos.elements.coronagraphs.LyotCoronagraph.transfer:1 of
msgid "Return the field after the occulting disk and the Lyot stop."
msgstr ""

#: lumos.elements.coronagraphs.VortexCoronagraph:1 of
#, python-brace-format
msgid "Vortex phase mask :math:`e^{il\\theta}` followed by a Lyot stop."
msgstr ""

#: lumos.elements.coronagraphs.VortexCoronagraph.transfer:1 of
msgid "Return the field after the vortex mask and the Lyot stop."
msgstr ""

#: lumos.elements.fibers:1 of
msgid ""
"Optical fibres: injection, guided propagation and extraction (§5.9, step "
"P6.7)."
msgstr ""

#: lumos.elements.fibers:3 of
msgid ""
"A :class:`Fiber` receives the field on its input face (a "
":class:`~lumos.fields.Wavefront`, :class:`~lumos.fields.Wavecube` or "
":class:`~lumos.fields.IncoherentBundle`, the fibre axis at the coordinate"
" origin) and projects it on its guided modes :math:`\\psi_n`, normalised "
"on the grid (:math:`\\sum |\\psi_n|^2 \\Delta x \\Delta y = 1`):"
msgstr ""

#: lumos.elements.fibers:8 of
msgid ""
"a_n = \\sum E\\,\\psi_n^*\\, \\Delta x\\, \\Delta y,\n"
"\n"
msgstr ""

#: lumos.elements.fibers:10 of
msgid ""
"so :math:`|a_n|^2` is the power coupled into mode :math:`n` (the overlap-"
"integral efficiency of Shaklan & Roddier 1988 for a single mode). Over "
"the length :math:`L` every mode gets the phase :math:`\\beta_n L`, "
":math:`\\beta_n = 2\\pi n_{\\mathrm{eff},n}/\\lambda`, and the power "
"transmission :math:`10^{-\\alpha L/10}` of the attenuation "
":math:`\\alpha`. Outputs: ``modes``, the amplitudes at the output end (a "
":class:`~lumos.fields.ModalField`, one guided lane whose modes are the LP"
" modes and polarisations), and ``out``, the near field :math:`\\sum_n a_n"
" \\psi_n` on the output face, sampled on the input grid. On a "
":class:`~lumos.fields.Bus` of beams, the fibre acts on every lane (one "
"identical fibre per lane, ADR-0023) and both outputs are buses."
msgstr ""

#: lumos.elements.fibers:20 of
msgid "Injection from a pupil plane"
msgstr ""

#: lumos.elements.fibers:21 of
msgid ""
"With ``injection_focal_length`` :math:`f > 0`, the input is a field in a "
"pupil plane (the output of a "
":class:`~lumos.elements.telescopes.TelescopeArray` or a "
":class:`~lumos.elements.telescopes.Telescope`) focused on the fibre face "
"by an ideal lens. The lens maps the face to the pupil by a Fourier "
"transform, which is unitary, so the overlap is computed in the pupil with"
" the modes imaged there,"
msgstr ""

#: lumos.elements.fibers:26 of
#, python-brace-format
msgid ""
"\\tilde\\psi_n(x, y) = \\frac{1}{\\lambda f} \\iint \\psi_n(\\xi, "
"\\eta)\\,\n"
"e^{-2i\\pi (x\\xi + y\\eta)/(\\lambda f)}\\, d\\xi\\, d\\eta ,\n"
"\n"
msgstr ""

#: lumos.elements.fibers:29 of
#, python-format
msgid ""
"a Gaussian of waist :math:`w_p = \\lambda f / (\\pi w_0)` for the "
"Gaussian model (computed by a matrix Fourier transform of the sampled "
"mode otherwise). This gives the coupling efficiency of a telescope pupil "
"(at most about 81 % for a circular pupil) and the antenna lobe of the "
"fibre for off-axis sources (Shaklan & Roddier 1988; Ruilier 1998, Proc. "
"SPIE 3350, 319). The ``out`` port is then the guided light collimated "
"back by the same lens, :math:`\\sum_n a_n \\tilde\\psi_n`, on the input "
"grid."
msgstr ""

#: lumos.elements.fibers:35 of
msgid ""
"Modes come from :mod:`lumos.physics.fibers`: exact LP modes "
"(``mode_model=\"lp\"``; modes with :math:`\\ell \\ge 1` have a cosine "
"``a`` and a sine ``b`` orientation), or the Gaussian approximation of "
"LP01 (``\"gaussian\"``) with the given mode field diameter or Marcuse's "
"waist. The modes are those guided at the shortest wavelength; at longer "
"wavelengths the modes beyond cutoff carry no light. Material dispersion "
"is not modelled (constant ``cladding_index`` and numerical aperture)."
msgstr ""

#: lumos.elements.fibers.Fiber:1 of
msgid ""
"Step-index fibre: injection into LP modes, propagation over its length, "
"near field at its output."
msgstr ""

#: lumos.elements.fibers.Fiber.v_number:1 of
msgid "Normalised frequency ``V = 2π a NA / λ``."
msgstr ""

#: lumos.elements.fibers.Fiber.mode_labels:1 of
msgid "Names of the scalar modes guided at ``wavelength``."
msgstr ""

#: lumos.elements.fibers.Fiber.mode_fields:1 of
msgid ""
"Normalised mode fields at ``wavelength`` sampled on ``grid``, shape ``(n,"
" ny, nx)``."
msgstr ""

#: lumos.elements.fibers.Fiber.effective_indices:1 of
msgid "Effective indices of the modes guided at ``wavelength``."
msgstr ""

#: lumos.elements.fibers.Fiber.transfer:1 of
msgid ""
"Couple the light into the modes, propagate it and rebuild the output near"
" field."
msgstr ""

#: lumos.elements.photonics:1 of
msgid ""
"Integrated photonics (§5.9, steps P6.8 and P15.6): components, chips and "
"recombiner presets."
msgstr ""

#: lumos.elements.photonics:3 of
msgid ""
"Every component maps a :class:`~lumos.fields.Bus` of guided lanes (one "
"guide each, ADR-0023) to a new bus through its scattering matrix "
":math:`S(\\lambda)` (:mod:`lumos.fields.smatrix`), acting on the lanes "
"listed in its ``channels`` setting (all lanes when empty) and leaving the"
" others unchanged; a single :class:`~lumos.fields.ModalField` is a bus of"
" one lane. A diagonal component (waveguide, phase shifter) acts on each "
"selected lane; a mixing component applies its matrix to the vector of all"
" the modes of its selected lanes, which must describe the same sources "
"(otherwise they cannot interfere). Components with as many outputs as "
"input modes write their outputs on the same lanes; the others "
"(Y-junctions, non-square matrices) put single-mode output lanes where "
"their first selected lane was. A chip is an "
":class:`~lumos.core.group.ElementGroup` chaining components; "
":func:`bracewell` and :func:`kernel_nuller` build the recombiners of "
"Bracewell (1978) and Martinache & Ireland (2018)."
msgstr ""

#: lumos.elements.photonics:15 of
msgid "Components"
msgstr ""

#: lumos.elements.photonics:16 of
msgid ""
":class:`Waveguide`: :math:`10^{-\\alpha L/20} e^{2i\\pi n_\\mathrm{eff} "
"L/\\lambda}` on each channel."
msgstr ""

#: lumos.elements.photonics:17 of
#, python-brace-format
msgid ""
":class:`PhaseShifter`: :math:`e^{i\\phi}`, with :math:`\\phi = "
"\\phi_0\\lambda_0/\\lambda` for a thermo-optic shifter (an optical path) "
"or :math:`\\phi_0` if achromatic."
msgstr ""

#: lumos.elements.photonics:19 of
#, python-brace-format
msgid ""
":class:`DirectionalCoupler`: :math:`\\begin{pmatrix} t & i\\kappa \\\\ "
"i\\kappa & t\\end{pmatrix}`, :math:`\\kappa^2` the power coupling ratio."
msgstr ""

#: lumos.elements.photonics:21 of
#, python-brace-format
msgid ""
":class:`YJunction`: splitter :math:`(1, 1)^T/\\sqrt{2}` or combiner "
":math:`(1, 1)/\\sqrt{2}`, which radiates the antisymmetric part of its "
"inputs."
msgstr ""

#: lumos.elements.photonics:23 of
#, python-brace-format
msgid ""
":class:`Crossing`: transmission :math:`\\sqrt{1 - x}` across and "
"crosstalk :math:`i\\sqrt{x}`."
msgstr ""

#: lumos.elements.photonics:24 of
msgid ""
":class:`MMI`: :math:`N \\times N` multimode interference coupler computed"
" with the slab mode solver of :mod:`lumos.physics.photonics`; with "
"``length = 0`` it is the general-interference coupler of length :math:`3 "
"L_\\pi / N` at the reference wavelength (Soldano & Pennings 1995)."
msgstr ""

#: lumos.elements.photonics:27 of
msgid ""
":class:`TransferMatrix`: a simplified MMI given by its matrix "
":math:`S_{ij} = A_{ij} e^{i\\phi_{ij}}` (output :math:`i`, input "
":math:`j`) at a wavelength :math:`\\lambda_0`; the same at every "
"wavelength, or with phases that are optical paths "
"(:math:`\\phi\\lambda_0/\\lambda`). It may have more or fewer outputs "
"than inputs; a passive component has a largest singular value at most 1 "
"(a matrix that amplifies is refused)."
msgstr ""

#: lumos.elements.photonics.KERNEL_PAIRS:1 of
msgid ""
"Pairs of outputs of :func:`kernel_nuller` whose differences are the "
"kernels."
msgstr ""

#: lumos.elements.photonics.MMI:1 of
msgid "N × N multimode interference coupler computed with a slab mode solver."
msgstr ""

#: lumos.elements.photonics.MMI.port_lanes:1 of
msgid "Return the number of ports of the coupler."
msgstr ""

#: lumos.elements.photonics.MMI.transfer:1 of
msgid "Mix the selected channels."
msgstr ""

#: lumos.elements.photonics.Crossing:1 of
msgid "Waveguide crossing with a power crosstalk."
msgstr ""

#: lumos.elements.photonics.Crossing.n_inputs:1
#: lumos.elements.photonics.DirectionalCoupler.n_inputs:1
#: lumos.elements.photonics.PhotonicComponent.n_inputs:1 of
msgid "any number, the matrix is diagonal and acts on each lane)."
msgstr ""

#: lumos.elements.photonics.Crossing.n_inputs:3
#: lumos.elements.photonics.DirectionalCoupler.n_inputs:3
#: lumos.elements.photonics.PhotonicComponent.n_inputs:3 of
msgid "Number of input modes (None"
msgstr ""

#: lumos.elements.photonics.Crossing.transfer:1 of
msgid "Cross the two selected channels."
msgstr ""

#: lumos.elements.photonics.DirectionalCoupler:1 of
msgid "Lossless symmetric directional coupler between two channels."
msgstr ""

#: lumos.elements.photonics.DirectionalCoupler.transfer:1 of
msgid "Couple the two selected channels."
msgstr ""

#: lumos.elements.photonics.PhaseShifter:1 of
msgid ""
"Phase shifter (thermo-optic: the phase is an optical path, set at the "
"reference wavelength)."
msgstr ""

#: lumos.elements.photonics.PhaseShifter.transfer:1 of
msgid "Shift the phase of the selected channels."
msgstr ""

#: lumos.elements.photonics.PhotonicComponent:1 of
msgid "Base class: a scattering matrix applied to some lanes of a bus of guides."
msgstr ""

#: lumos.elements.photonics.PhotonicComponent.port_lanes:1 of
msgid ""
"Return the number of lanes the component mixes (``None`` for a diagonal "
"component)."
msgstr ""

#: lumos.elements.photonics.TransferMatrix:1 of
msgid ""
"Simplified MMI: a component given by its complex transfer matrix "
"(amplitude and phase) at a wavelength."
msgstr ""

#: lumos.elements.photonics.TransferMatrix:3 of
msgid ""
"Row ``i`` of the matrix is the output ``i``, column ``j`` the input "
"``j``: the output amplitudes are ``a_out = S a_in`` with ``S_ij = "
"amplitudes[i][j] exp(i phases[i][j])``. The default is the ideal 3-dB "
"coupler ``(1/√2) [[1, i], [i, 1]]``."
