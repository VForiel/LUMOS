msgstr ""

#: lumos.plotting.plot_phase:1 of
msgid "Draw the phase of a wavefront in ``[-π, π]`` with a cyclic colour map."
msgstr ""

#: lumos.plotting.plot_phase:3 of
msgid "Scalar or polarised wavefront (``component`` selects Ex = 0 or Ey = 1)."
msgstr ""

#: lumos.plotting.plot_phase:4 of
msgid "Mask the phase where the amplitude is below ``threshold × max amplitude``."
msgstr ""

