#: lumos.core.param.State:1 of
msgid ""
"A physical quantity describing the current state of an equipment (changed"
" by its actions)."
msgstr ""

#: lumos.core.priors:1 of
msgid "Prior distributions attached to free parameters (REQ-EL-3)."
msgstr ""

#: lumos.core.priors:3 of
msgid ""
"Priors describe what is known about a free parameter before calibration "
"or inference. They carry physical units, so they can be checked against "
"the parameter they are attached to. Plain numbers are accepted for "
"dimensionless parameters. :meth:`Prior.sample` draws values (Monte-Carlo "
"runs); log-densities are added with the inference blocks (phase 17)."
msgstr ""

#: lumos.core.priors.LogUniform:1 of
msgid ""
"Log-uniform distribution between ``low`` and ``high`` (``0 < low < "
"high``)."
msgstr ""

#: lumos.core.priors.LogUniform:3 of
msgid ""
"Suited to scale parameters known only to an order of magnitude (fluxes, "
"contrasts...)."
msgstr ""

#: lumos.core.priors.LogUniform.sample:1 of
msgid "Draw uniformly in ``log`` between ``log(low)`` and ``log(high)``."
msgstr ""

#: lumos.core.priors.Normal:1 of
msgid ""
"Normal (Gaussian) distribution of mean ``mean`` and standard deviation "
"``std > 0``."
msgstr ""

#: lumos.core.priors.Normal.sample:1 of
msgid "Draw from the normal distribution."
msgstr ""

#: lumos.core.priors.Prior:1 of
msgid "Base class of prior distributions."
msgstr ""

#: lumos.core.priors.Prior:3 of
msgid ""
"Subclasses are frozen dataclasses whose first field fixes the unit of the"
" distribution."
msgstr ""

#: lumos.core.priors.Prior.unit:1 of
msgid "Unit of the values described by the prior."
msgstr ""

#: lumos.core.priors.Prior.sample:1 of
msgid "Draw values from the distribution with the NumPy generator ``rng``."
msgstr ""

#: lumos.core.priors.Uniform:1 of
msgid "Uniform distribution between ``low`` and ``high`` (``low < high``)."
msgstr ""

#: lumos.core.priors.Uniform.sample:1 of
msgid "Draw uniformly between ``low`` and ``high``."
msgstr ""

#: lumos.core.priors.prior_from_json:1 of
msgid "Decode a prior encoded by :func:`prior_to_json`."
msgstr ""

#: lumos.core.priors.prior_from_json:3 of
