"Optically thin flat ring or disk seen inclined (debris disks, exo-"
"zodiacal dust)."
msgstr ""

#: lumos.scenes.diffuse.SersicComponent:1 of
msgid ""
"Sérsic profile (n = 1: exponential disk, n = 4: de Vaucouleurs elliptical"
" galaxy)."
msgstr ""

#: lumos.scenes.diffuse.SurfaceBrightnessComponent:1 of
msgid ""
"Base class of uniform backgrounds: surface brightness, spectrum and "
"sampling."
msgstr ""

#: lumos.scenes.diffuse.UniformBackground:1 of
msgid ""
"Uniform background (sky, thermal background of the instrument) with a "
"flat or blackbody spectrum."
msgstr ""

#: lumos.scenes.diffuse._background_transfer.<locals>.transfer:1 of
