# Reverse proxy of a public LUMOS instance: HTTPS with automatic certificates (Let's Encrypt),
# WebSockets and the MCP endpoint forwarded to the container.
{$LUMOS_HOST:lumos.example.org} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
	}
	# Content Security Policy: scripts from the instance only. connect-src stays open (https:, local
	# servers) because the assistant calls the model endpoint chosen by the user from the browser.
	@interface not path /api/docs
	header @interface Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	# Swagger UI of FastAPI loads its script and style from jsDelivr, with an inline bootstrap script
	@apidocs path /api/docs
	header @apidocs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	# Built files have a content hash in their name: cache them for a year
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	request_body {
		max_size 20MB
	}
	reverse_proxy lumos:8000
}
