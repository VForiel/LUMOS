{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumos-maxima.readthedocs.io/en/latest/lumos-1.3.schema.json",
  "title": "LUMOS document",
  "description": "A .lumos file: an element, an element group or a whole context.",
  "type": "object",
  "required": [
    "lumos_format",
    "kind"
  ],
  "properties": {
    "lumos_format": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "kind": {
      "enum": [
        "element",
        "group",
        "context",
        "procedure",
        "component"
      ]
    },
    "lumos_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    },
    "element": {
      "$ref": "#/$defs/element"
    },
    "group": {
      "$ref": "#/$defs/group"
    },
    "context": {
      "$ref": "#/$defs/settings"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/child"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "feedbacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feedback"
      }
    },
    "procedures": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/procedure"
      }
    },
    "procedure": {
      "$ref": "#/$defs/procedure"
    },
    "component": {
      "$ref": "#/$defs/component"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/component"
      }
    },
    "ui": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "element"
          }
        }
      },
      "then": {
        "required": [
          "element"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "group"
          }
        }
      },
      "then": {
        "required": [
          "group"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "procedure"
          }
        }
      },
      "then": {
        "required": [
          "procedure"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "component"
          }
        }
      },
      "then": {
        "required": [
          "component"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "context"
          }
        }
      },
      "then": {
        "required": [
          "context",
          "elements",
          "connections"
        ]
      }
    }
  ],
  "$defs": {
    "component": {
      "description": "A declarative component (ADR-0025): a template filled with data, no code.",
      "type": "object",
      "required": [
        "id",
        "version",
        "template",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9_]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template": {
          "enum": [
            "transfer_matrix",
            "gain_phase",
            "spectral_transmission",
            "composite"
          ]
        },
        "params": {
          "type": "object"
        },
        "body": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "procedure": {
      "description": "A procedure: steps run in order (ADR-0024), each naming its kind in 'do'.",
      "type": "object",
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "do"
      ],
      "properties": {
        "do": {
          "enum": [
            "action",
            "measure",
            "repeat",
            "for_each",
            "process",
            "set",
            "use",
            "wait",
            "if",
            "save",
            "show"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "else": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value": {},
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "type_version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/quantity"
          }
        },
        "settings": {
          "type": "object"
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/quantity"
          }
        },
        "free": {
          "type": "object"
        },
        "driver": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "type_version"
      ]
    },
    "group": {
      "type": "object",
      "properties": {
        "type": {
          "const": "lumos.group"
        },
        "group_type": {
          "type": "string",
          "description": "registered specialised group class"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/child"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "exposed_ports": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*(\\.[A-Za-z_][A-Za-z0-9_\\-]*)+$"
          }
        }
      },
      "required": [
        "type",
        "children"
      ]
    },
    "child": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*$"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "anyOf": [
        {
          "$ref": "#/$defs/element"
        },
        {
          "$ref": "#/$defs/group"
        }
      ]
    },
    "connection": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*(\\.[A-Za-z_][A-Za-z0-9_\\-]*)+$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*(\\.[A-Za-z_][A-Za-z0-9_\\-]*)+$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*(\\.[A-Za-z_][A-Za-z0-9_\\-]*)+$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_\\-]*(\\.[A-Za-z_][A-Za-z0-9_\\-]*)+$"
        },
        "mode": {
          "enum": [
            "set",
            "add"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "simulation",
            "operation"
          ]
        },
        "twin": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer"
        },
        "backend": {
          "type": "object",
          "properties": {
            "preferred": {
              "type": "string"
            }
          }
        },
        "clock": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "elapsed": {
              "$ref": "#/$defs/quantity"
            }
          },
          "required": [
            "start",
            "elapsed"
          ]
        },
        "observation": {
          "type": "object",
          "properties": {
            "band": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "min": {
                      "$ref": "#/$defs/quantity"
                    },
                    "max": {
                      "$ref": "#/$defs/quantity"
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ]
                }
              ]
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "rule": {
              "enum": [
                "midpoint",
                "gauss"
              ]
            },
            "extra": {
              "type": "object"
            }
          }
        },
        "simulate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "twin",
        "seed",
        "clock"
      ]
    }
  }
}
